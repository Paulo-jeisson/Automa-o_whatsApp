[Unit]
Description=IAATENDE 2.0 persistent queue worker
After=network.target iaatende.service

[Service]
Type=oneshot
User=iaatende
Group=www-data
WorkingDirectory=/opt/iaatende
EnvironmentFile=/etc/iaatende/iaatende.env
ExecStart=/opt/iaatende/venv/bin/python manage.py process_jobs --queue whatsapp --limit 500

[Install]
WantedBy=multi-user.target
