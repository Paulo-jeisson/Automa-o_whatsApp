[Unit]
Description=ZapFluxo persistent queue worker
After=network.target zapfluxo.service

[Service]
Type=oneshot
User=zapfluxo
Group=www-data
WorkingDirectory=/opt/zapfluxo
EnvironmentFile=/etc/zapfluxo/zapfluxo.env
ExecStart=/opt/zapfluxo/venv/bin/python manage.py process_jobs --queue whatsapp --limit 500

[Install]
WantedBy=multi-user.target
