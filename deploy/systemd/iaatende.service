[Unit]
Description=IAATENDE 2.0 Gunicorn
After=network.target postgresql.service

[Service]
Type=notify
User=iaatende
Group=www-data
WorkingDirectory=/opt/iaatende
EnvironmentFile=/etc/iaatende/iaatende.env
RuntimeDirectory=iaatende
RuntimeDirectoryMode=0755
ExecStart=/opt/iaatende/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/iaatende/gunicorn.sock \
    --access-logfile - \
    --error-logfile - \
    app.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=30
PrivateTmp=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
