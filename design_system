  <script>
    // URL da API principal (servidor separado da landing)
    const LEAD_API_URL    = 'salvar-lead.php';
    const STRIPE_URL_MENSAL = 'https://buy.stripe.com/14A4gyeRw4Xj3VFaPjeAg01';
    const STRIPE_URL_ANUAL  = 'https://buy.stripe.com/dRm28qgZE61n77R2iNeAg00';
    let _selectedPlan = 'anual';

    // Interceptar todos os botões de compra
    document.querySelectorAll('[data-lead-btn]').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        _selectedPlan = this.dataset.plan || 'anual';
        openLeadModal();
      });
    });

    function openLeadModal() {
      document.getElementById('leadOverlay').classList.add('open');
      document.getElementById('leadError').style.display = 'none';
      document.getElementById('leadSubmit').disabled = false;
      document.getElementById('leadSubmit').textContent = '';
      document.getElementById('leadSubmit').innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg> Continuar para compra';
      setTimeout(() => document.getElementById('leadNome').focus(), 100);
    }

    function closeLeadModal() {
      document.getElementById('leadOverlay').classList.remove('open');
    }

    // Fechar ao clicar fora do modal
    document.getElementById('leadOverlay').addEventListener('click', function(e) {
      if (e.target === this) closeLeadModal();
    });

    // Máscara de telefone: (XX) XXXXX-XXXX
    document.getElementById('leadTelefone').addEventListener('input', function(e) {
      let d = this.value.replace(/\D/g, '').slice(0, 11);
      if (d.length === 0) { this.value = ''; return; }
      let masked = '(' + d.slice(0, 2);
      if (d.length > 2) masked += ') ' + d.slice(2, d.length > 10 ? 7 : 6);
      if (d.length > (d.length > 10 ? 7 : 6)) masked += '-' + d.slice(d.length > 10 ? 7 : 6);
      this.value = masked;
    });

    // Enter para avançar campos
    ['leadNome','leadEmail','leadTelefone'].forEach((id, i, arr) => {
      document.getElementById(id).addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          if (i < arr.length - 1) document.getElementById(arr[i+1]).focus();
          else submitLead();
        }
      });
    });

    async function submitLead() {
      const nome     = document.getElementById('leadNome').value.trim();
      const email    = document.getElementById('leadEmail').value.trim();
      const telefone = document.getElementById('leadTelefone').value.trim();
      const errEl    = document.getElementById('leadError');
      const btn      = document.getElementById('leadSubmit');

      errEl.style.display = 'none';
      // Limpa borda de erro de todos os campos
      ['leadNome','leadEmail','leadTelefone'].forEach(id =>
        document.getElementById(id).style.borderColor = ''
      );

      function showErr(msg, fieldId) {
        errEl.textContent = msg;
        errEl.style.display = 'block';
        if (fieldId) {
          document.getElementById(fieldId).style.borderColor = 'var(--magenta)';
          document.getElementById(fieldId).focus();
        }
      }

      // Honeypot: bot preencheu o campo oculto
      if (document.getElementById('leadWebsite').value) {
        window.open(_selectedPlan === 'mensal' ? STRIPE_URL_MENSAL : STRIPE_URL_ANUAL, '_blank');
        closeLeadModal();
        return;
      }

      if (!nome) { showErr('Informe seu nome completo.', 'leadNome'); return; }

      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
      if (!email) { showErr('Informe seu e-mail.', 'leadEmail'); return; }
      if (!emailOk) { showErr('E-mail inválido. Ex: nome@dominio.com', 'leadEmail'); return; }

      const telDigits = telefone.replace(/\D/g, '');
      if (!telefone) { showErr('Informe seu WhatsApp.', 'leadTelefone'); return; }
      if (telDigits.length < 10 || telDigits.length > 13) {
        showErr('Telefone inválido. Informe DDD + número (ex: 11 99999-9999).', 'leadTelefone');
        return;
      }

      btn.disabled = true;
      btn.innerHTML = 'Aguarde...';

      try {
        const resp = await fetch(LEAD_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nome, email, telefone })
        });
        if (!resp.ok) {
          const err = await resp.json().catch(() => ({}));
          console.warn('[Lead API] Erro:', resp.status, err);
        }
      } catch (e) {
        console.warn('[Lead API] Falha de rede:', e.message);
      }

      // Sempre redireciona, independente do resultado da API
      window.open(_selectedPlan === 'mensal' ? STRIPE_URL_MENSAL : STRIPE_URL_ANUAL, '_blank');
      closeLeadModal();
    }
  </script>

