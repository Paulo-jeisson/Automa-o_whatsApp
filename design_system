    }
    .chat-bubble.ai-bubble {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text-hi);
      border-radius: 0 8px 8px 8px;
    }
    .chat-bubble.user-bubble {
      background: var(--cyan-dim);
      border: 1px solid rgba(0,229,255,0.2);
      color: var(--cyan);
      border-radius: 8px 0 8px 8px;
      text-align: right;
    }
    .chat-time {
      font-family: 'Syne Mono', monospace;
      font-size: 0.55rem;
      color: var(--text-lo);
      margin-top: 4px;
    }
    .typing-indicator {
      display: flex;
      gap: 4px;
      align-items: center;
      padding: 12px 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0 8px 8px 8px;
      width: fit-content;
    }
    .typing-dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      background: var(--text-lo);
      animation: bounce-dot 1.2s ease-in-out infinite;
    }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @keyframes bounce-dot {
      0%, 80%, 100% { transform: translateY(0); background: var(--text-lo); }
      40%            { transform: translateY(-5px); background: var(--cyan); }
    }
    .terminal-status {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px;
      border-top: 1px solid var(--border);
      background: var(--deep);
    }
    .status-online {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Syne Mono', monospace;
      font-size: 0.6rem;
      color: var(--green);
      letter-spacing: 0.1em;
    }
    .status-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 6px var(--green);
      animation: pulse-ring 2s ease-out infinite;
    }
    .status-count {
      font-family: 'Syne Mono', monospace;
      font-size: 0.6rem;
      color: var(--text-lo);
      letter-spacing: 0.08em;
    }

    /* === SOCIAL PROOF BAR === */
    .proof-bar {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: var(--deep);
      padding: 32px 0;
      position: relative;
      z-index: 1;
    }
    .proof-bar::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, var(--cyan), transparent);
      opacity: 0.2;
    }
    .proof-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      text-align: center;
    }
    .proof-item {
      padding: 8px 24px;
      border-right: 1px solid var(--border);
    }
    .proof-item:last-child { border-right: none; }
    .proof-number {
      font-size: 2.8rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--cyan);
      display: block;
      line-height: 1;
      margin-bottom: 6px;
      text-shadow: 0 0 30px rgba(0,229,255,0.4);
    }
    .proof-label {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: none;
      color: #c8d0f0;
    }

    /* === SECTION BASE === */
    section { position: relative; z-index: 1; }
    .section-pad { padding: 100px 0; }

    .section-eyebrow {
      font-family: 'Syne Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--cyan);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-eyebrow::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--border-mid), transparent);
    }
    .section-title {
      font-size: clamp(2rem, 3.5vw, 3rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1.05;
      margin-bottom: 16px;
    }
    .section-title em {
      font-style: normal;
      color: var(--cyan);
    }
    .section-sub {
      font-size: 1rem;
      color: var(--text-mid);
      line-height: 1.7;
      max-width: 560px;
    }

    /* === PROBLEM SECTION === */
    .problem { background: var(--deep); }
    .problem-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .problem-list { margin-top: 40px; }
    .problem-item {
      display: flex;
      gap: 16px;
      padding: 18px 0;
      border-bottom: 1px solid var(--border);
    }
    .problem-item:last-child { border-bottom: none; }
    .problem-icon {
      width: 36px; height: 36px;
      border-radius: 3px;
