    /* === FEATURES === */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 60px;
    }
    .feature-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 28px;
      position: relative;
      overflow: visible;
      transition: border-color 0.3s ease, transform 0.3s ease;
    }
    .feature-card::before {
      content: '';
      position: absolute;
      top: -1px; left: -1px;
      width: 18px; height: 18px;
      border-top: 1px solid var(--cyan);
      border-left: 1px solid var(--cyan);
      border-radius: 2px 0 0 0;
      transition: width 0.3s ease, height 0.3s ease;
    }
    .feature-card:hover { border-color: var(--border-mid); transform: translateY(-4px); }
    .feature-card:hover::before { width: 28px; height: 28px; }
    .feature-icon {
      width: 44px; height: 44px;
      border-radius: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
      position: relative;
    }
    .feature-icon [data-lucide] { width: 20px; height: 20px; }
    .feature-icon.cyan { background: var(--cyan-dim); border: 1px solid rgba(0,229,255,0.2); color: var(--cyan); }
    .feature-icon.green { background: var(--green-dim); border: 1px solid rgba(0,255,136,0.2); color: var(--green); }
    .feature-icon.magenta { background: var(--magenta-dim); border: 1px solid rgba(255,0,128,0.2); color: var(--magenta); }
    .feature-icon.violet { background: rgba(124,58,237,0.1); border: 1px solid rgba(124,58,237,0.25); color: #a78bfa; }
    .feature-icon.amber { background: rgba(255,193,7,0.08); border: 1px solid rgba(255,193,7,0.2); color: var(--amber); }
    .feature-icon [data-lucide] { color: inherit; }
    .feature-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-hi);
      margin-bottom: 8px;
      letter-spacing: -0.02em;
    }
    .feature-desc {
      font-size: 0.85rem;
      color: var(--text-mid);
      line-height: 1.6;
    }
    .feature-tag {
      display: inline-block;
      margin-top: 14px;
      font-family: 'Syne Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 2px;
    }
    .feature-tag.new { background: var(--cyan-dim); color: var(--cyan); border: 1px solid rgba(0,229,255,0.2); }
    .feature-tag.hot { background: var(--magenta-dim); color: var(--magenta); border: 1px solid rgba(255,0,128,0.2); }

    /* === HOW IT WORKS === */
    .how { background: var(--deep); }
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      margin-top: 60px;
      position: relative;
    }
    .steps-grid::before {
      content: '';
      position: absolute;
      top: 32px;
      left: calc(16.66% + 20px);
      right: calc(16.66% + 20px);
      height: 1px;
      background: linear-gradient(90deg, var(--cyan), var(--violet), var(--cyan));
      opacity: 0.3;
    }
    .step-item {
      padding: 0 30px;
      text-align: center;
      position: relative;
    }
    .step-num {
      width: 64px; height: 64px;
      border-radius: 3px;
      border: 1px solid var(--border-mid);
      background: var(--panel);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Syne Mono', monospace;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--cyan);
      margin: 0 auto 24px;
      position: relative;
      z-index: 1;
    }
    .step-num::after {
      content: '';
      position: absolute;
      inset: -4px;
      border: 1px solid rgba(0,229,255,0.12);
      border-radius: 4px;
    }
    .step-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-hi);
      margin-bottom: 10px;
      letter-spacing: -0.02em;
    }
    .step-desc {
      font-size: 0.85rem;
      color: var(--text-mid);
      line-height: 1.6;
    }

    /* === EXPLAINER VIDEO === */
    .explainer-section {
      padding: 80px 0 90px;
      background: var(--void);
      position: relative;
      z-index: 1;
    }
    .explainer-header { margin-bottom: 44px; }
    .explainer-header .section-eyebrow { justify-content: center; }
    .explainer-wrap {
      max-width: 860px;
      margin: 0 auto;
      background: var(--panel);
      border: 1px solid var(--border-mid);
      border-radius: 4px;
      overflow: hidden;
      box-shadow:
        0 0 0 1px rgba(0,229,255,0.06),
        0 0 80px rgba(0,229,255,0.07),
        0 40px 80px rgba(0,0,0,0.55);
      position: relative;
    }
    .explainer-topline {
      height: 2px;
      background: linear-gradient(90deg, var(--violet), var(--cyan), var(--green));
    }
    .explainer-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px;
      background: var(--deep);
      border-bottom: 1px solid var(--border);
    }
    .explainer-bar-title {
      display: flex;
      align-items: center;
      gap: 7px;
      font-family: 'Syne Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      color: var(--text-mid);
    }
    .explainer-bar-title [data-lucide] { width: 12px; height: 12px; color: var(--cyan); }
    .explainer-video-wrap {
      position: relative;
      background: #000;
      line-height: 0;
    }
    .explainer-video-wrap video {
      width: 100%;
      display: block;
      max-height: 520px;
      object-fit: contain;
    }
    /* Scan-line sutil */
    .explainer-scanline {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 3px,
        rgba(0,0,0,0.04) 3px,
        rgba(0,0,0,0.04) 4px
      );
      pointer-events: none;
      z-index: 1;
    }
    /* Botão unmute */
    .explainer-unmute {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(12, 12, 30, 0.82);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border-hi);
      border-radius: 40px;
      padding: 10px 22px 10px 16px;
      color: var(--text-hi);
      font-family: 'Syne Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.22s ease;
      white-space: nowrap;
    }
    .explainer-unmute:hover {
      background: rgba(0,229,255,0.12);
      border-color: var(--cyan);
      color: var(--cyan);
      box-shadow: 0 0 24px rgba(0,229,255,0.25);
    }
    .explainer-unmute.is-muted {
      border-color: rgba(255,0,128,0.5);
      color: var(--magenta);
    }
    .unmute-icon {
      width: 28px; height: 28px;
      border-radius: 50%;
      background: var(--cyan-dim);
      border: 1px solid rgba(0,229,255,0.3);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .explainer-unmute.is-muted .unmute-icon {
      background: var(--magenta-dim);
      border-color: rgba(255,0,128,0.3);
    }
    .unmute-icon svg { width: 14px; height: 14px; color: var(--cyan); }
    .explainer-unmute.is-muted .unmute-icon svg { color: var(--magenta); }
    .explainer-footer {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 32px;
      padding: 12px 20px;
      background: var(--deep);
      border-top: 1px solid var(--border);
      font-family: 'Syne Mono', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.1em;
      color: var(--text-lo);
      text-transform: uppercase;
    }

    /* === AGENDAMENTO SPOTLIGHT === */
    .agenda-spot { background: var(--deep); }
    .agenda-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
    .agenda-flow {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .af-step {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 14px 18px;
      transition: border-color 0.25s;
    }
    .af-step:hover { border-color: var(--border-mid); }
    .af-icon {
      width: 38px; height: 38px;
      border-radius: 50%;
      background: var(--magenta-dim);
      border: 1px solid rgba(255,0,128,0.25);
      color: var(--magenta);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .af-icon [data-lucide] { width: 17px; height: 17px; }
    .af-text { display: flex; flex-direction: column; gap: 3px; }
    .af-text strong { font-size: 0.88rem; color: var(--text-hi); }
    .af-text span   { font-size: 0.78rem; color: var(--text-mid); }
    .af-arrow {
      padding: 3px 0 3px 24px;
      color: var(--border-mid);
    }
    .af-arrow [data-lucide] { width: 14px; height: 14px; }

    /* Mockup Agenda */
    .agenda-mockup {
      background: var(--panel);
      border: 1px solid var(--border-mid);
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 0 60px rgba(0,229,255,0.06), 0 30px 60px rgba(0,0,0,0.4);
    }
    .agenda-mockup::before {
      content: '';
      display: block;
      height: 2px;
      background: linear-gradient(90deg, var(--green), var(--cyan), var(--violet));
    }
    .agenda-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: var(--deep);
      border-bottom: 1px solid var(--border);
    }
    .agenda-chat { padding: 16px; display: flex; flex-direction: column; gap: 10px; }
    .agenda-msg {
      padding: 10px 14px;
      border-radius: 3px;
      font-size: 0.82rem;
      line-height: 1.5;
      max-width: 85%;
    }
    .agenda-msg.user-msg {
      background: var(--cyan-dim);
      border: 1px solid rgba(0,229,255,0.18);
      color: var(--cyan);
      align-self: flex-end;
      border-radius: 8px 0 8px 8px;
    }
    .agenda-msg.ai-msg {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text-hi);
      align-self: flex-start;
      border-radius: 0 8px 8px 8px;
    }
    .agenda-msg.ai-confirm {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      background: var(--green-dim);
      border-color: rgba(0,255,136,0.28);
      color: var(--green);
      max-width: 95%;
    }
    .agenda-msg.ai-confirm [data-lucide] { width: 18px; height: 18px; flex-shrink: 0; margin-top: 2px; }
    .agenda-footer {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      background: var(--deep);
      border-top: 1px solid var(--border);
      font-family: 'Syne Mono', monospace;
      font-size: 0.6rem;
      color: var(--text-lo);
      letter-spacing: 0.08em;
    }
    .agenda-footer [data-lucide] { width: 13px; height: 13px; color: var(--green); }

    /* === VIDEO TESTIMONIALS === */
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
      margin-top: 60px;
      max-width: 760px;
      margin-left: auto;
      margin-right: auto;
    }
    .video-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 3px;
      overflow: hidden;
      transition: border-color 0.3s ease;
    }
    .video-card:hover { border-color: var(--border-hi); }
    .video-wrap {
      position: relative;
    }
    .video-card video {
      width: 100%;
      aspect-ratio: 9/16;
      display: block;
      object-fit: cover;
      background: var(--void);
    }
    .video-play-btn {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(10, 10, 30, 0.38);
      cursor: pointer;
      transition: opacity 0.25s ease;
    }
    .video-play-btn.hidden { opacity: 0; pointer-events: none; }
    .video-play-btn .play-circle {
      width: 64px; height: 64px;
      border-radius: 50%;
      border: 2px solid var(--cyan);
      display: flex; align-items: center; justify-content: center;
      background: rgba(0, 229, 255, 0.08);
      box-shadow: 0 0 24px rgba(0, 229, 255, 0.25);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .video-play-btn:hover .play-circle {
      transform: scale(1.1);
      box-shadow: 0 0 40px rgba(0, 229, 255, 0.45);
    }
    .video-play-btn .play-circle svg {
      width: 26px; height: 26px;
      fill: var(--cyan);
      margin-left: 3px;
    }
    .video-controls {
      position: absolute;
      bottom: 10px; left: 0; right: 0;
      display: none;
      justify-content: center;
      gap: 8px;
      z-index: 2;
    }
    .video-controls.visible { display: flex; }
    .vc-btn {
      display: flex; align-items: center; justify-content: center;
      width: 32px; height: 32px;
      border-radius: 2px;
      border: 1px solid rgba(0,229,255,0.45);
      background: rgba(10,10,30,0.72);
      color: var(--cyan);
      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease;
      backdrop-filter: blur(4px);
    }
    .vc-btn:hover { background: rgba(0,229,255,0.1); border-color: var(--cyan); }
    .vc-btn svg { width: 14px; height: 14px; stroke: var(--cyan); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .video-info {
      padding: 14px 16px;
      border-top: 1px solid var(--border);
    }
    .video-name {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-hi);
      margin-bottom: 3px;
    }
    .video-role {
      font-family: 'Syne Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-mid);
    }

    /* === PRICING ANCHOR === */
    .pricing-anchor {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      max-width: 680px;
      margin: 40px auto 48px;
      border: 1px solid var(--border-mid);
      border-radius: 4px;
      overflow: hidden;
    }
    .pa-col {
      flex: 1;
      padding: 24px 28px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .pa-bad  { background: rgba(255,0,128,0.04); }
    .pa-good { background: rgba(0,229,255,0.04); }
    .pa-label {
      font-family: 'Syne Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-lo);
    }
    .pa-bad .pa-label  { color: rgba(255,80,80,0.6); }
    .pa-good .pa-label { color: var(--cyan); }
    .pa-value {
      font-size: 2rem;
      font-weight: 900;
      letter-spacing: -0.03em;
      color: var(--text-mid);
    }
    .pa-good .pa-value { color: var(--cyan); text-shadow: 0 0 30px rgba(0,229,255,0.4); }
    .pa-value span {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-lo);
      letter-spacing: 0;
    }
    .pa-detail { font-size: 0.78rem; color: var(--text-mid); }
    .pa-sub    { font-size: 0.72rem; color: var(--text-lo); font-family: 'Syne Mono', monospace; }
    .pa-sub.pa-green { color: var(--green); }
    .pa-vs {
      padding: 0 20px;
      font-family: 'Syne Mono', monospace;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      color: var(--text-lo);
      border-left: 1px solid var(--border);
      border-right: 1px solid var(--border);
      align-self: stretch;
      display: flex;
      align-items: center;
    }

    /* === PRICING === */
    .pricing-bg { background: var(--deep); }
    .pricing-wrapper {
      display: flex;
      justify-content: center;
      gap: 28px;
      flex-wrap: wrap;
      margin-top: 60px;
    }
    .pricing-card {
      background: var(--panel);
      border: 1px solid var(--border-mid);
      border-radius: 4px;
      padding: 48px 56px;
      max-width: 460px;
      width: 100%;
      position: relative;
      overflow: hidden;
      text-align: center;
    }
    .pricing-card::before {
      content: '';
      position: absolute;
      top: -1px; left: -1px; right: -1px; height: 3px;
      background: linear-gradient(90deg, var(--violet), var(--cyan), var(--green));
    }
    .pricing-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 0%, rgba(0,229,255,0.05), transparent 60%);
      pointer-events: none;
    }
    .pricing-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: 'Syne Mono', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--amber);
      background: rgba(255,193,7,0.08);
      border: 1px solid rgba(255,193,7,0.2);
      padding: 4px 14px;
      border-radius: 2px;
      margin-bottom: 24px;
    }
    .pricing-name {
      font-size: 1.6rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--text-hi);
      margin-bottom: 8px;
    }
    .pricing-price {
      margin: 24px 0;
      line-height: 1;
    }
    .pricing-price .currency {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--text-mid);
      vertical-align: super;
    }
    .pricing-price .amount {
      font-size: 4rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--text-hi);
    }
    .pricing-price .period {
      font-family: 'Syne Mono', monospace;
      font-size: 0.7rem;
      color: var(--text-mid);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .pricing-desc {
      font-size: 0.85rem;
      color: var(--text-mid);
      margin-bottom: 32px;
      line-height: 1.6;
    }
    .pricing-features {
      list-style: none;
      text-align: left;
      margin-bottom: 36px;
    }
    .pricing-features li {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.88rem;
      color: var(--text-hi);
    }
    .pricing-features li:last-child { border-bottom: none; }
    .pricing-features [data-lucide] { width: 14px; height: 14px; color: var(--green); flex-shrink: 0; }
    .btn-buy {
      display: block;
      width: 100%;
      padding: 18px;
      background: var(--cyan);
      color: var(--void);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 2px;
      transition: all 0.25s ease;
      text-align: center;
    }
    .btn-buy:hover {
      background: var(--text-hi);
      box-shadow: 0 8px 32px rgba(0,229,255,0.35);
      transform: translateY(-2px);
    }
    .pricing-guarantee {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 18px;
      font-family: 'Syne Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-mid);
    }
    .pricing-guarantee [data-lucide] { width: 12px; height: 12px; color: var(--green); }

    /* === FAQ === */
    .faq-list {
      max-width: 740px;
      margin: 60px auto 0;
    }
    .faq-item {
      border: 1px solid var(--border);
      border-radius: 3px;
      margin-bottom: 8px;
      overflow: hidden;
      transition: border-color 0.2s ease;
    }
    .faq-item.open { border-color: var(--border-mid); }
    .faq-q {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 22px;
      cursor: pointer;
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text-hi);
      background: var(--panel);
      user-select: none;
    }
    .faq-q:hover { background: var(--surface); }
    .faq-chevron {
      flex-shrink: 0;
      color: var(--text-mid);
      transition: transform 0.3s ease, color 0.2s ease;
    }
    .faq-chevron [data-lucide] { width: 16px; height: 16px; color: inherit; }
    .faq-item.open .faq-chevron { transform: rotate(180deg); color: var(--cyan); }
    .faq-a {
      display: none;
      padding: 0 22px 18px;
      font-size: 0.88rem;
      color: var(--text-mid);
      line-height: 1.7;
      background: var(--panel);
      animation: accordion-open 0.2s ease-out;
    }
    .faq-item.open .faq-a { display: block; }

    /* === FINAL CTA === */
    .final-cta {
      text-align: center;
      padding: 120px 0;
      position: relative;
      overflow: hidden;
    }
    .final-cta-orb {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 600px; height: 600px;
