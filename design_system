      animation: float 6s ease-in-out infinite;
    }
    .hero-terminal::before {
      content: '';
      position: absolute;
      top: -1px; left: -1px; right: -1px; height: 2px;
      background: linear-gradient(90deg, var(--violet), var(--cyan), var(--green));
    }
    .terminal-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      background: var(--deep);
      border-bottom: 1px solid var(--border);
    }
    .terminal-dot { width: 10px; height: 10px; border-radius: 50%; }
    .terminal-dot:nth-child(1) { background: #ff5f57; }
    .terminal-dot:nth-child(2) { background: #febc2e; }
    .terminal-dot:nth-child(3) { background: #28c840; }
    .terminal-title {
      font-family: 'Syne Mono', monospace;
      font-size: 0.65rem;
      color: var(--text-mid);
      letter-spacing: 0.1em;
      margin-left: auto;
      margin-right: auto;
    }
    .terminal-body { padding: 20px; }
    .chat-msg {
      display: flex;
      gap: 10px;
      margin-bottom: 14px;
      animation: slide-in-left 0.5s ease-out both;
    }
    .chat-msg.bot { animation-delay: 0.3s; }
    .chat-msg.user { flex-direction: row-reverse; animation-delay: 0.6s; }
    .chat-msg.bot2 { animation-delay: 0.9s; }
    .chat-avatar {
      width: 28px; height: 28px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.7rem; font-weight: 700;
      flex-shrink: 0;
      font-family: 'Syne Mono', monospace;
    }
    .chat-avatar.ai-avatar {
      background: linear-gradient(135deg, var(--violet), var(--cyan));
      color: white;
    }
    .chat-avatar.user-avatar {
      background: var(--surface);
      border: 1px solid var(--border-mid);
      color: var(--text-mid);
