  <script src="./Atende IA - Chatbot WhatsApp Premium_files/socket.io.js.baixados"></script>
  <script>
    const socket = io();
    const $ = id => document.getElementById(id);

    // ===== MULTI-TENANT: Gerenciamento por Usuário =====
    let currentUserId = null;
    let userInfo = null;

    // Inicializar sistema multi-tenant
    async function initializeMultiTenant() {
      try {
        // Obter informações do usuário logado
        const response = await fetch('/api/me', { credentials: 'same-origin' });
        if (!response.ok) {
          console.error('Erro ao obter informações do usuário');
          return;
        }

        userInfo = await response.json();
        currentUserId = userInfo.id;

        console.log(`✓ Multi-Tenant inicializado`);

        // Configurar listeners Socket.IO com namespace do usuário
        setupSocketListeners();

        // Verificar status atual do WhatsApp
        await checkWhatsAppStatus();

      } catch (error) {
        console.error('Erro ao inicializar multi-tenant:', error);
      }
    }

    // Verificar status atual do WhatsApp
    async function checkWhatsAppStatus() {
      try {
        const response = await fetch('/api/whatsapp/status', { credentials: 'same-origin' });
        if (response.ok) {
          const status = await response.json();
          console.log(`📊 Status atual do WhatsApp:`, status);
          handleStatus(status);
        }
      } catch (error) {
        console.error('Erro ao verificar status do WhatsApp:', error);
      }
    }

    // Configurar eventos Socket.IO por usuário
    function setupSocketListeners() {
      if (!currentUserId) {
        console.error('❌ userId não definido! Não é possível configurar Socket.IO');
        return;
      }

      console.log(`🔌 Configurando Socket.IO para usuário ${currentUserId}`);

      // QR Code com namespace do usuário
      socket.on(`qr:${currentUserId}`, (qrDataUrl) => {
        console.log(`📱 QR Code recebido para usuário ${currentUserId}`);
        handleQRCode(qrDataUrl);
      });

      // Status com namespace do usuário
      socket.on(`status:${currentUserId}`, (data) => {
        console.log(`📊 Status WhatsApp recebido`);
        handleStatus(data);
      });
    }

    // Handler para QR Code
    function handleQRCode(qrDataUrl) {
      const area = $('qr-area');
      const statusConectado = $('status-conectado');
      const btnDesconectar = $('btnDesconectar');
      const btnGerarQR = $('btnGerarQR');
      const btnLimparSessao = $('btnLimparSessao');
      const qrHelp = $('qr-help');

      if (qrDataUrl === 'loading') {
        // Mostrando loading com contador
        area.style.display = 'block';
        area.innerHTML = `
          <div class="msg status-pendente qr-loading">
            <div class="spinner" style="width: 40px; height: 40px; border-width: 4px; margin: 0 auto 16px;"></div>
            <p style="margin: 0; font-weight: 600;">Inicializando WhatsApp...</p>
            <p id="loading-counter" style="margin: 8px 0 0; font-size: 0.85rem; color: var(--text-muted);">0 segundos</p>
          </div>
        `;

        statusConectado.style.display = 'none';
        btnDesconectar.style.display = 'none';
        btnGerarQR.style.display = 'inline-block';
        btnLimparSessao.style.display = 'inline-block';
        qrHelp.style.display = 'block';

        // Contador de tempo
        let seconds = 0;
        const counterInterval = setInterval(() => {
          seconds++;
          const counter = document.getElementById('loading-counter');
          if (counter) {
            counter.textContent = `${seconds} segundo${seconds !== 1 ? 's' : ''}`;
            if (seconds >= 60) {
              counter.innerHTML += '<br><small style="color: var(--warning);">Demorando muito? Tente "Limpar sessão e tentar"</small>';
            }
          } else {
            clearInterval(counterInterval);
          }
        }, 1000);

        // Limpar contador quando QR Code aparecer ou sumir
        setTimeout(() => clearInterval(counterInterval), 120000); // 2 minutos max

      } else if (qrDataUrl) {
        // Mostrando QR Code
        area.style.display = 'block';
        area.innerHTML = `<img src="${qrDataUrl}" alt="QR Code WhatsApp" class="qr-code">`;
        statusConectado.style.display = 'none';
        btnDesconectar.style.display = 'none';
        btnGerarQR.style.display = 'inline-block';
        btnGerarQR.textContent = '🔄 Gerar novo QR Code';
        btnLimparSessao.style.display = 'inline-block';
        qrHelp.style.display = 'block';
      } else {
        // QR sumiu (provavelmente conectado, deixar handleStatus gerenciar)
        area.style.display = 'none';
        area.innerHTML = '';
      }
    }

    // Handler para Status
    function handleStatus(data) {
      const statusConectado = $('status-conectado');
      const qrArea = $('qr-area');
      const qrHelp = $('qr-help');
      const btnDesconectar = $('btnDesconectar');
      const btnGerarQR = $('btnGerarQR');
      const btnLimparSessao = $('btnLimparSessao');

      // Atualizar badge do header
      const sistemaBadge = $('sistemaBadge');
      if (sistemaBadge) {
        if (data.conectado) {
          sistemaBadge.textContent = '● SISTEMA ATIVO';
          sistemaBadge.classList.remove('inativo');
        } else {
          sistemaBadge.textContent = '● SISTEMA INATIVO';
          sistemaBadge.classList.add('inativo');
        }
      }

      if (data.conectado) {
        // WhatsApp CONECTADO
        statusConectado.style.display = 'block';
        statusConectado.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <div style="width: 12px; height: 12px; background: #10b981; border-radius: 50%; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.3); animation: pulse-glow 2s ease-in-out infinite;"></div>
              <span style="font-weight: 600; color: var(--success);">✓ WhatsApp conectado!</span>
            </div>
            <span style="font-size: 0.85rem; color: var(--text-muted);">Conectado e pronto para receber mensagens</span>
          </div>
        `;

        // Ocultar área de QR Code e mensagem de ajuda
        qrArea.style.display = 'none';
        qrHelp.style.display = 'none';

        // Mostrar apenas botão "Desconectar"
        btnDesconectar.style.display = 'inline-flex';
        btnGerarQR.style.display = 'none';
        btnLimparSessao.style.display = 'none';

      } else {
        // WhatsApp DESCONECTADO
        statusConectado.style.display = 'none';

        // Mostrar área de QR Code e mensagem de ajuda
        qrArea.style.display = 'block';
        qrHelp.style.display = 'block';

        // Mostrar botões de conexão, ocultar "Desconectar"
        btnDesconectar.style.display = 'none';
        btnGerarQR.style.display = 'inline-block';
        btnLimparSessao.style.display = 'inline-block';
        btnGerarQR.textContent = '📱 Gerar QR Code';
      }
    }

    // Verificar e restaurar sessão WhatsApp do usuário
    async function checkAndRestoreWhatsApp() {
      if (!currentUserId) return;

      console.log(`🔍 Verificando sessão WhatsApp do usuário ${currentUserId}...`);

      // Aguardar 2 segundos para o sistema estabilizar
      await new Promise(resolve => setTimeout(resolve, 2000));

      // O status já é verificado via checkWhatsAppStatus() no initializeMultiTenant()
      // O backend vai restaurar automaticamente se existir sessão salva
      console.log(`ℹ️ Sessão WhatsApp será restaurada automaticamente se existir`);
    }

    // Inicializar ao carregar a página
    document.addEventListener('DOMContentLoaded', async () => {
      await initializeMultiTenant();

      // Carregar configurações do usuário
      await carregarConfig();

      // Após inicializar, verificar WhatsApp
      await checkAndRestoreWhatsApp();
    });

    // Tabs
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('ativo'));
        btn.classList.add('active');
        $(`tab-${btn.dataset.tab}`).classList.add('ativo');

        if (btn.dataset.tab === 'gerador') carregarDadosGeradorPrompt();
        if (btn.dataset.tab === 'calendario') { carregarCalendarioConfig(); carregarAgendamentos(); }
      });
    });

    // ==========================================
    // GERADOR DE PROMPT PERSONALIZADO
    // ==========================================

    // Carregar dados salvos do gerador de prompt
    async function carregarDadosGeradorPrompt() {
      try {
        const response = await fetch('/api/config', { credentials: 'same-origin' });
        if (!response.ok) return;

        const data = await response.json();

        // Preencher campos com valores salvos
        if (data.agent_name) $('agentName').value = data.agent_name;
        if (data.company_name) $('companyName').value = data.company_name;
        if (data.business_sector) $('businessSector').value = data.business_sector;
        if (data.business_slogan) $('businessSlogan').value = data.business_slogan;
        if (data.agent_profession) $('agentProfession').value = data.agent_profession;
        if (data.personality_tone) $('personalityTone').value = data.personality_tone;
        if (data.prompt_complement) $('promptComplement').value = data.prompt_complement;
      } catch (error) {
        console.error('Erro ao carregar dados do gerador:', error);
      }
    }

    // Gerar prompt personalizado via LLM (meta-prompt no backend)
    $('btnGerarPrompt').addEventListener('click', async () => {
      const btn = $('btnGerarPrompt');
      const originalText = btn.textContent;

      try {
        btn.disabled = true;
        btn.textContent = '⏳ Gerando com IA...';

        const payload = {
          agent_name: $('agentName').value.trim(),
          company_name: $('companyName').value.trim(),
          business_sector: $('businessSector').value.trim(),
          business_slogan: $('businessSlogan').value.trim(),
          agent_profession: $('agentProfession').value.trim(),
          personality_tone: $('personalityTone').value.trim(),
          prompt_complement: $('promptComplement').value.trim()
        };

        if (!payload.company_name) {
          alert('⚠️ Por favor, preencha o nome da empresa.');
          btn.disabled = false;
          btn.textContent = originalText;
          return;
        }

        const response = await fetch('/api/gerar-prompt-personalizado', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(payload)
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok || !data.ok) {
          const msg = data.message || `Erro ${response.status} ao gerar prompt.`;
          throw new Error(msg);
        }

        // Salvar automaticamente no banco de dados (sem mostrar o prompt na tela)
        btn.textContent = '⏳ Ativando prompt...';
        await fetch('/api/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt_sistema: data.prompt })
        });
        // Atualiza o campo de prompt da aba Prompt da IA
        if ($('promptSistema')) $('promptSistema').value = data.prompt;

        btn.textContent = '✅ Prompt gerado e ativado!';
        setTimeout(() => { btn.textContent = originalText; }, 3000);

      } catch (error) {
        console.error('Erro ao gerar prompt:', error);
        alert('❌ ' + (error.message || 'Erro ao gerar prompt. Confira se a chave da IA está configurada e tente novamente.'));
        btn.textContent = originalText;
      } finally {
        btn.disabled = false;
      }
    });

    // Copiar prompt gerado
    $('btnCopiarPrompt').addEventListener('click', async () => {
      const btn = $('btnCopiarPrompt');
      const originalText = btn.textContent;

      try {
        const promptTexto = $('promptResultado').value;
        await navigator.clipboard.writeText(promptTexto);

        btn.textContent = '✅ Copiado!';
        btn.style.background = '#10b981';

        setTimeout(() => {
          btn.textContent = originalText;
          btn.style.background = '';
        }, 2000);
      } catch (error) {
        console.error('Erro ao copiar:', error);
        // Fallback para navegadores antigos
        $('promptResultado').select();
        document.execCommand('copy');

        btn.textContent = '✅ Copiado!';
        setTimeout(() => {
          btn.textContent = originalText;
        }, 2000);
      }
    });

    // Botões com loading state
    function setButtonLoading(btn, isLoading, originalText) {
      if (isLoading) {
        btn.disabled = true;
        btn.innerHTML = `${originalText}<span class="spinner"></span>`;
      } else {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    }

    $('btnGerarQR').addEventListener('click', async () => {
      const btn = $('btnGerarQR');
      const originalText = btn.textContent;
      setButtonLoading(btn, true, 'Gerando');
      $('btnLimparSessao').disabled = true;
      try {
        await fetch('/api/whatsapp/restart', { method: 'POST' });
      } catch (e) {
        console.error('Erro ao gerar QR:', e);
      }
      setTimeout(() => {
        setButtonLoading(btn, false, originalText);
        $('btnLimparSessao').disabled = false;
      }, 3000);
    });

    $('btnLimparSessao').addEventListener('click', async () => {
      if (!confirm('Isso vai limpar a sessão do WhatsApp. Você precisará escanear o QR Code de novo. Continuar?')) return;
      const btn = $('btnLimparSessao');
      const originalText = btn.textContent;
      setButtonLoading(btn, true, 'Limpando');
      $('btnGerarQR').disabled = true;
      try {
        await fetch('/api/whatsapp/restart?limpar=1', { method: 'POST' });
      } catch (e) {
        console.error('Erro ao limpar sessão:', e);
      }
      setTimeout(() => {
        setButtonLoading(btn, false, originalText);
        $('btnGerarQR').disabled = false;
      }, 3000);
    });

    $('btnDesconectar').addEventListener('click', async () => {
      if (!confirm('Desconectar o WhatsApp?')) return;
      const btn = $('btnDesconectar');
      btn.disabled = true;
      try {
        await fetch('/api/whatsapp/disconnect', { method: 'POST' });
        // Voltar ao estado desconectado
        $('status-conectado').style.display = 'none';
        $('qr-area').style.display = 'block';
        $('qr-area').innerHTML = `<div class="msg status-pendente">Desconectado. Clique em "Gerar novo QR Code" para conectar novamente.</div>`;
        $('btnGerarQR').style.display = 'inline-block';
        $('btnLimparSessao').style.display = 'inline-block';
        $('qr-help').style.display = 'block';
      } catch (e) {
        console.error('Erro ao desconectar:', e);
      }
      btn.disabled = false;
    });

    // Botão de Logout
    $('btnLogout').addEventListener('click', async () => {
      if (!confirm('Deseja realmente sair do sistema?')) return;
      try {
        window.location.href = '/logout';
      } catch (e) {
        console.error('Erro ao fazer logout:', e);
      }
      btn.style.display = 'none';
    });

    // Botão de Tema (dark/light)
    (function initTheme() {
      const saved = localStorage.getItem('neural-theme') || 'dark';
      applyTheme(saved);
    })();
    function applyTheme(theme) {
      const icon = document.getElementById('themeIcon');
      if (theme === 'light') {
        document.documentElement.classList.add('theme-light');
        if (icon) { icon.setAttribute('data-lucide', 'sun'); lucide.createIcons(); }
      } else {
        document.documentElement.classList.remove('theme-light');
        if (icon) { icon.setAttribute('data-lucide', 'moon'); lucide.createIcons(); }
      }
    }
    $('btnThemeToggle').addEventListener('click', () => {
      const isLight = document.documentElement.classList.contains('theme-light');
      const next = isLight ? 'dark' : 'light';
      localStorage.setItem('neural-theme', next);
      applyTheme(next);
    });

    // IA fixa — DeepSeek (sem UI de configuração)
    function alternarProvedor() {} // removida — IA fixa no servidor
    function obterModeloAtual() { return 'deepseek-v4-flash'; }
    function salvarTudo() {}      // removida — sem configuração de provedor

    // Carregar config
    async function carregarConfig() {
      try {
        const r = await fetch('/api/config/full');
        const cfg = await r.json();

        $('promptSistema').value = cfg.prompt_sistema || '';
        $('responseDelay').value = cfg.response_delay || 3;
        if ($('useCalendar')) $('useCalendar').checked = cfg.use_calendar || false;
      } catch (e) {
        console.error('Erro ao carregar config:', e);
      }
    }

    // (sem event listener de provedor — IA é fixa)

    // Stub de salvarTudo (não utilizado mais)
    async function _salvarTudoLegado() {
      try {
        const x = false; // desativado
      } catch (e) {
        console.error('Erro ao salvar:', e);
        alert('❌ Erro ao salvar. Tente novamente.');
      }
    }

    // Função para salvar Prompt e Tempo de Resposta
    async function salvarPrompt() {
      try {
        const config = {
          prompt_sistema: $('promptSistema').value.trim(),
          response_delay: parseInt($('responseDelay').value) || 3
        };

        console.log('💾 Salvando prompt e tempo de resposta');

        await fetch('/api/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(config)
        });
        alert('✅ Prompt e tempo de resposta salvos com sucesso!');
      } catch (e) {
        console.error('Erro ao salvar:', e);
        alert('❌ Erro ao salvar. Tente novamente.');
      }
    }

    // Áudio gerenciado pelo sistema — funções removidas da UI
    function salvarAudio() {}
    function validarChaveWhisper() {}

    if ($('salvarIA')) $('salvarIA').addEventListener('click', salvarTudo);
    $('salvarPrompt').addEventListener('click', salvarPrompt);

    // Contador de segundos durante inicialização do WhatsApp
    let loadingCounterInterval = null;
    function startLoadingCounter() {
      // Limpar intervalo anterior se existir
      if (loadingCounterInterval) {
        clearInterval(loadingCounterInterval);
      }

      let seconds = 0;
      const counterElement = $('loading-counter');

      if (counterElement) {
        // Atualizar imediatamente
        counterElement.textContent = '0 segundos';

        // Iniciar contador
        loadingCounterInterval = setInterval(() => {
          seconds++;
          if (counterElement) {
            counterElement.textContent = `${seconds} segundo${seconds !== 1 ? 's' : ''}`;
          }
        }, 1000);
      }
    }

    // Limpar contador quando QR aparecer ou conectar
    const originalQrHandler = socket.listeners('qr')[0];
    socket.off('qr');
    socket.on('qr', (qrDataUrl) => {
      if (qrDataUrl !== 'loading' && loadingCounterInterval) {
        clearInterval(loadingCounterInterval);
        loadingCounterInterval = null;
      }
      originalQrHandler(qrDataUrl);
    });

    // =====================================
    // GOOGLE CALENDAR (OAUTH2)
    // =====================================

    // ── Calendário próprio ────────────────────────────────────────
    function verificarStatusCalendar() {}  // stub — removido Google Calendar
    function atualizarStatusCalendar() {}  // stub
    function listarCalendarios() {}        // stub

    function atualizarPreviewLink() {
      const slug = $('calSlug').value.trim();
      const preview = $('calLinkPreview');
      const anchor  = $('calLinkAnchor');
      if (slug && /^[a-z0-9-]{2,}$/.test(slug)) {
        const url = `${window.location.origin}/calendario/${slug}`;
        anchor.textContent = url;
        anchor.href = url;
        preview.style.display = 'block';
      } else {
        preview.style.display = 'none';
      }
    }

    // Mostrar/ocultar horários de fim de semana ao marcar/desmarcar
    function atualizarHorariosWeekend() {
      const sabChecked = [...document.querySelectorAll('#diasSemanaCheck input')].find(c=>c.value==='6')?.checked;
      const domChecked = [...document.querySelectorAll('#diasSemanaCheck input')].find(c=>c.value==='0')?.checked;
      const el = (id, show) => { const e=$( id); if(e) e.style.display = show ? 'block' : 'none'; };
      el('sabadoHorarios', sabChecked);
      el('domingoHorarios', domChecked);
    }
    document.querySelectorAll('#diasSemanaCheck input[type=checkbox]').forEach(cb => {
      cb.addEventListener('change', atualizarHorariosWeekend);
    });

    async function carregarCalendarioConfig() {
      try {
        const r = await fetch('/api/calendario/config', { credentials: 'same-origin' });
        const d = await r.json();
        if (!d.ok || !d.config) return;
        const cfg = d.config;
        if ($('calSlug'))        { $('calSlug').value = cfg.slug || ''; atualizarPreviewLink(); }
        if ($('calNomeDisplay')) $('calNomeDisplay').value = cfg.nome_display || '';
        if ($('calHoraInicio'))  $('calHoraInicio').value = cfg.hora_inicio || '08:00';
        if ($('calHoraFim'))     $('calHoraFim').value    = cfg.hora_fim    || '18:00';
        if ($('calAlmocoInicio')) $('calAlmocoInicio').value = cfg.almoco_inicio || '';
        if ($('calAlmocoFim'))    $('calAlmocoFim').value   = cfg.almoco_fim   || '';
        if ($('calDuracaoSlot')) $('calDuracaoSlot').value  = cfg.duracao_slot || 30;
        if ($('useCalendar'))    $('useCalendar').checked   = !!cfg.ativo;
        if ($('calSabadoInicio'))  $('calSabadoInicio').value  = cfg.sabado_inicio  || '09:00';
        if ($('calSabadoFim'))     $('calSabadoFim').value     = cfg.sabado_fim     || '13:00';
        if ($('calDomingoInicio')) $('calDomingoInicio').value = cfg.domingo_inicio || '10:00';
        if ($('calDomingoFim'))    $('calDomingoFim').value    = cfg.domingo_fim    || '12:00';
        const diasAtivos = (cfg.dias_semana || '1,2,3,4,5').split(',').map(String);
        document.querySelectorAll('#diasSemanaCheck input[type=checkbox]').forEach(cb => {
          cb.checked = diasAtivos.includes(cb.value);
        });
        atualizarHorariosWeekend();
      } catch (e) { console.error('Erro ao carregar config do calendário:', e); }
    }

    if ($('salvarCalendarioConfig')) {
      $('salvarCalendarioConfig').addEventListener('click', async () => {
        const slug = ($('calSlug')?.value || '').trim().toLowerCase();
        if (slug && !/^[a-z0-9-]{3,50}$/.test(slug)) {
          alert('⚠️ Slug inválido. Use apenas letras minúsculas, números e hífens (3-50 caracteres).');
          return;
        }
        const dias = [...document.querySelectorAll('#diasSemanaCheck input[type=checkbox]:checked')]
          .map(cb => cb.value).join(',');
        if (!dias) { alert('⚠️ Selecione pelo menos um dia de atendimento.'); return; }
        const temSab = dias.includes('6'), temDom = dias.includes('0');
        const cfg = {
          slug: slug || null,
          nome_display: $('calNomeDisplay')?.value.trim() || null,
          ativo: $('useCalendar')?.checked ?? true,
          dias_semana: dias,
          hora_inicio: $('calHoraInicio')?.value || '08:00',
          hora_fim:    $('calHoraFim')?.value    || '18:00',
          duracao_slot: parseInt($('calDuracaoSlot')?.value) || 30,
          almoco_inicio: $('calAlmocoInicio')?.value || null,
          almoco_fim:    $('calAlmocoFim')?.value    || null,
          sabado_inicio:  temSab ? ($('calSabadoInicio')?.value  || null) : null,
          sabado_fim:     temSab ? ($('calSabadoFim')?.value     || null) : null,
          domingo_inicio: temDom ? ($('calDomingoInicio')?.value || null) : null,
          domingo_fim:    temDom ? ($('calDomingoFim')?.value    || null) : null,
        };
        try {
          const r = await fetch('/api/calendario/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(cfg)
          });
          const d = await r.json();
          if (!d.ok) { alert('❌ ' + (d.message || 'Erro ao salvar')); return; }
          alert('✅ Calendário configurado com sucesso!');
          atualizarPreviewLink();
          await carregarAgendamentos();
        } catch (e) { alert('❌ Erro de conexão.'); }
      });
    }

    async function carregarAgendamentos() {
      const el = $('agendamentosList');
      if (!el) return;
      try {
        const r = await fetch('/api/agendamentos', { credentials: 'same-origin' });
        const d = await r.json();
        if (!d.ok || !d.agendamentos.length) {
          el.innerHTML = '<p style="color:var(--text-mid);font-size:0.85rem;">Nenhum agendamento futuro.</p>';
          return;
        }
        const MESES = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
        const DIAS_SEMANA = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];

        // Agrupar por data
        const grupos = {};
        d.agendamentos.forEach(ag => {
          const isoData = String(ag.data).split('T')[0];
          if (!grupos[isoData]) grupos[isoData] = [];
          grupos[isoData].push(ag);
        });

        el.innerHTML = Object.entries(grupos).map(([iso, ags]) => {
          const dt = new Date(iso + 'T12:00:00');
          const dataFmt = `${DIAS_SEMANA[dt.getDay()]}, ${dt.getDate()} ${MESES[dt.getMonth()]} ${dt.getFullYear()}`;
          const rows = ags.map(ag => `
            <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--border);">
              <div>
                <strong style="font-size:0.88rem;">${ag.nome_cliente}</strong>
                ${ag.telefone_cliente ? `<span style="color:var(--text-mid);font-size:0.78rem;margin-left:8px;">${ag.telefone_cliente}</span>` : ''}
                ${ag.servico ? `<div style="font-size:0.76rem;color:var(--text-mid);margin-top:2px;">${ag.servico}</div>` : ''}
              </div>
              <div style="text-align:right;flex-shrink:0;margin-left:12px;">
                <div style="font-family:'Syne Mono',monospace;font-size:0.78rem;color:var(--cyan);font-weight:700;">${ag.hora_inicio}</div>
                <button onclick="cancelarAgendamento(${ag.id})" style="background:none;border:none;color:var(--magenta);font-size:0.68rem;cursor:pointer;margin-top:3px;letter-spacing:0.05em;">cancelar</button>
              </div>
            </div>`).join('');

          return `<div style="margin-bottom:16px;">
            <div style="font-family:'Syne Mono',monospace;font-size:0.6rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--cyan);padding:6px 0 4px;border-bottom:1px solid var(--border-mid);margin-bottom:4px;">
              📅 ${dataFmt} <span style="color:var(--text-lo);margin-left:6px;">${ags.length} agendamento${ags.length>1?'s':''}</span>
            </div>
            ${rows}
          </div>`;
        }).join('');
      } catch (e) { el.innerHTML = '<p style="color:var(--text-mid);font-size:0.85rem;">Erro ao carregar.</p>'; }
    }

    async function cancelarAgendamento(id) {
      if (!confirm('Cancelar este agendamento?')) return;
      await fetch(`/api/agendamentos/${id}`, { method: 'DELETE', credentials: 'same-origin' });
      await carregarAgendamentos();
    }

    // Inicializar
    carregarConfig();
    carregarCalendarioConfig();
    carregarAgendamentos();

    // Carregar info do usuário imediatamente
    carregarInfoUsuario();

    // Também carregar quando DOM estiver pronto (fallback)
    document.addEventListener('DOMContentLoaded', () => {
      console.log('[DOM] Página carregada, recarregando dados do usuário...');
      carregarInfoUsuario();
    });

    // =============================================
    // NÚMEROS PASS
    // =============================================
    async function loadNumerosPass() {
      const list = document.getElementById('numerosPassList');
      list.innerHTML = '<div style="text-align:center;color:var(--text-lo);padding:20px;font-family:\'Syne Mono\',monospace;font-size:0.7rem;letter-spacing:0.1em;">CARREGANDO...</div>';
      try {
        const res = await fetch('/api/numeros-pass', { credentials: 'same-origin' });
        const data = await res.json();
        renderNumerosPassList(data.numeros || []);
      } catch (e) {
        list.innerHTML = '<div style="text-align:center;color:var(--magenta);padding:20px;font-family:\'Syne Mono\',monospace;font-size:0.7rem;letter-spacing:0.1em;">ERRO AO CARREGAR</div>';
      }
    }

    function renderNumerosPassList(numeros) {
      const list = document.getElementById('numerosPassList');
      if (!numeros.length) {
        list.innerHTML = '<div style="text-align:center;color:var(--text-lo);padding:20px;font-family:\'Syne Mono\',monospace;font-size:0.7rem;letter-spacing:0.1em;">NENHUM NÚMERO NA LISTA</div>';
        return;
      }
      list.innerHTML = numeros.map(n => `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-radius:2px;margin-bottom:6px;background:var(--surface);border:1px solid var(--border);transition:border-color 0.2s;">
          <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-family:'Syne Mono',monospace;font-size:0.8rem;font-weight:600;color:var(--cyan);">${n.phone}</span>
            ${n.nome ? `<span style="color:var(--text-mid);font-size:0.82rem;">${n.nome}</span>` : ''}
          </div>
          <button onclick="deleteNumeroPass(${n.id})"
            style="background:transparent;border:1px solid rgba(255,0,128,0.2);color:var(--magenta);cursor:pointer;padding:5px 8px;border-radius:2px;display:flex;align-items:center;transition:all 0.2s;"
            onmouseover="this.style.background='rgba(255,0,128,0.1)'" onmouseout="this.style.background='transparent'"
            title="Remover"><i data-lucide="trash-2" style="width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;"></i></button>
        </div>
      `).join('');
      lucide.createIcons();
    }

    async function addNumeroPass() {
      const phone = document.getElementById('passPhone').value.trim();
      const nome = document.getElementById('passNome').value.trim();
      if (!phone) { alert('Informe o número de telefone.'); return; }
      try {
        const res = await fetch('/api/numeros-pass', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ phone, nome })
        });
        const data = await res.json();
        if (data.success) {
          document.getElementById('passPhone').value = '';
          document.getElementById('passNome').value = '';
          await loadNumerosPass();
        } else {
          alert(data.error || 'Erro ao adicionar número.');
        }
      } catch (e) {
        alert('Erro ao adicionar número.');
      }
    }

    async function deleteNumeroPass(id) {
      if (!confirm('Remover este número da lista Pass?')) return;
      try {
        const res = await fetch(`/api/numeros-pass/${id}`, {
          method: 'DELETE',
          credentials: 'same-origin'
        });
        const data = await res.json();
        if (data.success) {
          await loadNumerosPass();
        } else {
          alert(data.error || 'Erro ao remover número.');
        }
      } catch (e) {
        alert('Erro ao remover número.');
      }
    }
  </script>

  <!-- Modal Trocar Senha -->
  <div class="modal-overlay" id="passwordModal">
    <div class="modal-box">
      <h2>🔑 Trocar Senha</h2>
      <form id="passwordForm">
        <div class="form-group-modal">
          <label for="currentPassword">Senha Atual *</label>
          <input type="password" id="currentPassword" required="" minlength="6">
        </div>
        <div class="form-group-modal">
          <label for="newPassword">Nova Senha *</label>
          <input type="password" id="newPassword" required="" minlength="6">
        </div>
        <div class="form-group-modal">
          <label for="confirmPassword">Confirmar Nova Senha *</label>
          <input type="password" id="confirmPassword" required="" minlength="6">
        </div>
        <div class="modal-actions-box">
          <button type="button" class="btn btn-small" id="btnCancelPassword" style="background: var(--glass-bg); color: var(--text-secondary);">
            Cancelar
          </button>
          <button type="submit" class="btn btn-primary" id="btnSubmitPassword">
            Salvar Senha
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // ==========================================
    // GERENCIAMENTO DE USUÁRIO E SENHA
    // ==========================================

    // Carregar informações do usuário (email e validade)
    async function carregarInfoUsuario() {
      try {
        const response = await fetch('/api/me');

        if (!response.ok) {
          throw new Error(`Erro HTTP: ${response.status}`);
        }

        const data = await response.json();

        // Atualizar email do usuário
        const emailElement = document.getElementById('userEmail');
        if (emailElement && data.login) {
          emailElement.textContent = data.login;
        }

        // Atualizar validade
        const validityContainer = document.getElementById('userValidityText');
        if (validityContainer) {
          if (data.expiration_date) {
            const daysRemaining = data.days_remaining;
            const statusValidade = data.status_validade;

            let badgeClass = 'ativo';
            let statusText = '';
            let icon = '✓';

            if (statusValidade === 'expirado') {
              badgeClass = 'expirado';
              statusText = 'Expirado';
              icon = '❌';
            } else if (statusValidade === 'expirando') {
              badgeClass = 'expirando';
              statusText = `${daysRemaining} dias restantes`;
              icon = '⚠️';
            } else {
              badgeClass = 'ativo';
              statusText = `${daysRemaining} dias restantes`;
              icon = '✓';
            }

            validityContainer.innerHTML = `
              <span class="validity-badge ${badgeClass}">${icon} ${statusText}</span>
            `;
            // Exibir banner de pagamento se trial vencendo (≤3 dias) ou expirado
            const banner = document.getElementById('payment-banner');
            const bannerMsg = document.getElementById('banner-msg');
            if (banner && bannerMsg) {
              if (statusValidade === 'expirado') {
                bannerMsg.textContent = '❌ Seu acesso expirou. Assine para continuar usando o AtendeIA:';
                banner.className = 'banner-danger';
                banner.style.display = 'flex';
              } else if (statusValidade === 'expirando' && daysRemaining <= 3) {
                bannerMsg.textContent = `⚠️ Seu trial vence em ${daysRemaining} dia(s). Garanta seu acesso:`;
                banner.className = 'banner-warning';
                banner.style.display = 'flex';
              }
            }
          } else {
            validityContainer.innerHTML = `
              <span class="validity-badge sem_validade">♾️ Validade ilimitada</span>
            `;
          }
        }
      } catch (error) {
        console.error('[ERROR] Erro ao carregar dados do usuário:', error);

        const emailElement = document.getElementById('userEmail');
        const validityElement = document.getElementById('userValidityText');

        if (emailElement) {
          emailElement.textContent = 'Erro ao carregar';
          emailElement.style.color = '#f59e0b';
        }
        if (validityElement) {
          validityElement.innerHTML = `<span style="color:#f59e0b; font-size:0.85rem;">⚠️ Erro de conexão</span>`;
        }

        // Se for timeout, mostrar alerta ao usuário
        if (isTimeout) {
          console.warn('⚠️ Servidor não está respondendo. Verifique se o servidor está rodando.');
        }
      }
    }

    // Criar checkout Stripe e redirecionar
    async function assinar(plano) {
      try {
        const res = await fetch('/api/stripe/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ plano })
        });
        const data = await res.json();
        if (data.success && data.url) {
          window.location.href = data.url;
        } else {
          alert('Erro ao gerar link de pagamento: ' + (data.message || 'tente novamente.'));
        }
      } catch (err) {
        alert('Erro de conexão. Tente novamente.');
      }
    }

    // Abrir modal de troca de senha
    document.getElementById('btnChangePassword').addEventListener('click', () => {
      document.getElementById('passwordModal').classList.add('active');
      document.getElementById('passwordForm').reset();
    });

    // Fechar modal de troca de senha
    document.getElementById('btnCancelPassword').addEventListener('click', () => {
      document.getElementById('passwordModal').classList.remove('active');
    });

    // Fechar modal ao clicar fora
    document.getElementById('passwordModal').addEventListener('click', (e) => {
      if (e.target.id === 'passwordModal') {
        document.getElementById('passwordModal').classList.remove('active');
      }
    });

    // Submeter formulário de troca de senha
    document.getElementById('passwordForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const currentPassword = document.getElementById('currentPassword').value;
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      // Validações
      if (newPassword !== confirmPassword) {
        alert('As senhas não coincidem!');
        return;
      }

      if (newPassword.length < 6) {
        alert('A nova senha deve ter no mínimo 6 caracteres!');
        return;
      }

      const submitBtn = document.getElementById('btnSubmitPassword');
      submitBtn.disabled = true;
      submitBtn.textContent = '⏳ Salvando...';

      try {
        const response = await fetch('/api/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword, newPassword })
        });

        const data = await response.json();

        if (data.success) {
          alert('✅ Senha alterada com sucesso!');
          document.getElementById('passwordModal').classList.remove('active');
          document.getElementById('passwordForm').reset();
        } else {
          alert('❌ ' + (data.error || 'Erro ao alterar senha'));
        }
      } catch (error) {
        console.error('Erro ao trocar senha:', error);
        alert('❌ Erro de conexão ao trocar senha');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Salvar Senha';
      }
    });

    // ========================================
    // VER CONVERSAS - Visualizar histórico de conversas
    // ========================================
    let currentConversations = [];
    let selectedPhone = null;

    // Carregar lista de conversas
    async function carregarConversas() {
      try {
        const response = await fetch('/api/conversations');
        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.error || `HTTP ${response.status}`);
        }

        const conversas = await response.json();
        currentConversations = conversas;
        renderizarListaContatos(conversas);
      } catch (error) {
        console.error('Erro ao carregar conversas:', error);
        const container = $('contactsList');
        if (container) {
          container.innerHTML = `<div style="text-align: center; padding: 40px 20px; color: var(--danger);">
            <div style="font-size: 3rem; margin-bottom: 10px;">❌</div>
            <p style="color: var(--text-primary); font-weight: 600; margin-bottom: 8px;">Erro ao carregar conversas</p>
            <p style="color: var(--text-muted); font-size: 0.85rem;">${error.message}</p>
          </div>`;
        }
      }
    }

    // Renderizar lista de contatos
    function renderizarListaContatos(conversas, limitarExibicao = true) {
      const container = $('contactsList');

      if (!conversas || conversas.length === 0) {
        container.innerHTML = `<div style="text-align: center; padding: 40px 20px; color: var(--text-muted);">
          <div style="font-size: 3rem; margin-bottom: 10px;"><i data-lucide="inbox"></i></div>
          <p>Nenhuma conversa encontrada</p>
        </div>`;
        return;
      }

      // Limitar a 5 conversas mais recentes se limitarExibicao = true
      const totalConversas = conversas.length;
      const conversasExibir = limitarExibicao ? conversas.slice(0, 5) : conversas;
      const conversasOcultas = totalConversas - conversasExibir.length;

      // Adicionar cabeçalho com informações
      let headerHtml = '';
      if (limitarExibicao && conversasOcultas > 0) {
        headerHtml = `
          <div style="background: rgba(99, 102, 241, 0.1); border: 1px solid var(--primary-light); border-radius: 8px; padding: 10px; margin-bottom: 12px; text-align: center;">
            <small style="color: var(--text-secondary); font-size: 0.85rem;">
              Mostrando <strong>${conversasExibir.length}</strong> de <strong>${totalConversas}</strong> conversas<br>
              <span style="color: var(--text-muted); font-size: 0.75rem;">Use a busca para encontrar outras conversas</span>
            </small>
          </div>
        `;
      } else if (!limitarExibicao) {
        headerHtml = `
          <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid var(--success); border-radius: 8px; padding: 8px; margin-bottom: 12px; text-align: center;">
            <small style="color: var(--text-secondary); font-size: 0.85rem;">
              <strong>${totalConversas}</strong> conversa(s) encontrada(s)
            </small>
          </div>
        `;
      }

      const contactsHtml = conversasExibir.map(conversa => {
        const data = new Date(conversa.lastMessage.timestamp).toLocaleString('pt-BR');
        const isSelected = selectedPhone === conversa.phone;

        return `
          <div class="contact-card ${isSelected ? 'selected' : ''}" data-phone="${conversa.phone}">
            <div class="contact-header">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-lo);flex-shrink:0;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span class="contact-phone">${conversa.phone}</span>
            </div>
            <div class="contact-last-message">${conversa.lastMessage.content}</div>
            <div class="contact-info">
              <span class="contact-date">${data}</span>
              <span class="contact-count" style="display:inline-flex;align-items:center;gap:4px;">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                ${conversa.messageCount}
              </span>
            </div>
          </div>
        `;
      }).join('');

      container.innerHTML = headerHtml + contactsHtml;

      // Adicionar event listeners aos cards de contato
      container.querySelectorAll('.contact-card').forEach(card => {
        card.addEventListener('click', () => {
          const phone = card.dataset.phone;
          selecionarContato(phone);
        });
      });
    }

    // Selecionar contato e carregar mensagens
    async function selecionarContato(phone) {
      selectedPhone = phone;

      // Atualizar UI - marcar card selecionado
      document.querySelectorAll('.contact-card').forEach(card => {
        card.classList.toggle('selected', card.dataset.phone === phone);
      });

      // Carregar mensagens
      await carregarMensagensContato(phone);
    }

    // Carregar mensagens de um contato
    async function carregarMensagensContato(phone) {
      const container = $('messagesArea');
      container.innerHTML = `<div style="text-align:center;padding:40px 20px;color:var(--text-lo);font-family:'Syne Mono',monospace;font-size:0.65rem;letter-spacing:0.12em;">CARREGANDO MENSAGENS...</div>`;

      try {
        const response = await fetch(`/api/conversations/${encodeURIComponent(phone)}`);
        if (!response.ok) throw new Error('Erro ao carregar mensagens');

        const data = await response.json();
        renderizarMensagens(data.phone, data.messages);
      } catch (error) {
        console.error('Erro ao carregar mensagens:', error);
        container.innerHTML = `<div style="text-align:center;padding:40px 20px;color:var(--magenta);font-family:'Syne Mono',monospace;font-size:0.65rem;letter-spacing:0.12em;">ERRO AO CARREGAR MENSAGENS</div>`;
      }
    }

    // Renderizar mensagens
    function renderizarMensagens(phone, mensagens) {
      const container = $('messagesArea');

      if (!mensagens || mensagens.length === 0) {
        container.innerHTML = `<div style="text-align:center;padding:40px 20px;color:var(--text-lo);font-family:'Syne Mono',monospace;font-size:0.65rem;letter-spacing:0.12em;">NENHUMA MENSAGEM ENCONTRADA</div>`;
        return;
      }

      const header = `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border);">
          <div>
            <div style="font-size:0.92rem;font-weight:700;color:var(--text-hi);">Conversa com <span style="color:var(--cyan);font-family:'Syne Mono',monospace;">${phone}</span></div>
            <div style="margin-top:3px;font-family:'Syne Mono',monospace;font-size:0.6rem;letter-spacing:0.12em;color:var(--text-mid);">${mensagens.length} MENSAGENS</div>
          </div>
          <div style="display:flex;gap:8px;">
            <button class="btn btn-small btn-primary" onclick="exportarConversa('${phone}')" style="display:inline-flex;align-items:center;gap:6px;">
              <i data-lucide="download"></i> Exportar
            </button>
            <button class="btn btn-small btn-danger" onclick="deletarConversa('${phone}')" style="display:inline-flex;align-items:center;gap:6px;">
              <i data-lucide="trash-2"></i> Deletar
            </button>
          </div>
        </div>
      `;

      const messagesHTML = mensagens.map(msg => {
        const data = new Date(msg.timestamp).toLocaleString('pt-BR');
        const isUser = msg.role === 'user';
        const bgColor = isUser ? 'rgba(0,229,255,0.05)' : 'rgba(124,58,237,0.08)';
        const borderColor = isUser ? 'rgba(0,229,255,0.3)' : 'rgba(124,58,237,0.35)';
        const nameColor = isUser ? 'var(--cyan)' : '#a78bfa';
        const name = isUser ? 'Cliente' : 'IA';
        const iconSvg = isUser
          ? `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`
          : `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`;

        return `
          <div style="margin-bottom:10px;padding:12px 14px;background:${bgColor};border:1px solid ${borderColor};border-radius:2px;border-left:2px solid ${borderColor};">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
              <span style="display:inline-flex;align-items:center;gap:6px;font-family:'Syne Mono',monospace;font-size:0.62rem;letter-spacing:0.12em;font-weight:700;color:${nameColor};">${iconSvg} ${name}</span>
              <span style="font-family:'Syne Mono',monospace;font-size:0.58rem;letter-spacing:0.08em;color:var(--text-lo);">${data}</span>
            </div>
            <div style="white-space:pre-wrap;word-wrap:break-word;color:var(--text-hi);font-size:0.88rem;line-height:1.6;">${msg.content}</div>
          </div>
        `;
      }).join('');

      container.innerHTML = header + `<div style="overflow-y:auto;padding-right:6px;">${messagesHTML}</div>`;

      // Scroll para o final
      container.scrollTop = container.scrollHeight;
    }

    // Exportar conversa
    window.exportarConversa = async function(phone) {
      try {
        const response = await fetch(`/api/conversations/${encodeURIComponent(phone)}`);
        if (!response.ok) throw new Error('Erro ao carregar conversa');

        const data = await response.json();
        const content = `Conversa com ${phone}\nTotal de mensagens: ${data.messages.length}\n\n` +
          data.messages.map(msg => {
            const timestamp = new Date(msg.timestamp).toLocaleString('pt-BR');
            const role = msg.role === 'user' ? 'Cliente' : 'IA';
            return `[${timestamp}] ${role}:\n${msg.content}\n`;
          }).join('\n');

        // Criar e baixar arquivo
        const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `conversa_${phone}_${Date.now()}.txt`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        alert('✅ Conversa exportada com sucesso!');
      } catch (error) {
        console.error('Erro ao exportar conversa:', error);
        alert('❌ Erro ao exportar conversa');
      }
    };

    // Deletar conversa
    window.deletarConversa = async function(phone) {
      if (!confirm(`Tem certeza que deseja deletar a conversa com ${phone}?\n\nEsta ação não pode ser desfeita!`)) {
        return;
      }

      try {
        const response = await fetch(`/api/conversations/${encodeURIComponent(phone)}`, {
          method: 'DELETE'
        });

        if (!response.ok) throw new Error('Erro ao deletar conversa');

        alert('✅ Conversa deletada com sucesso!');

        // Recarregar lista de conversas
        selectedPhone = null;
        $('messagesArea').innerHTML = `<div style="text-align: center; padding: 80px 20px; color: var(--text-muted);">
          <div style="font-size: 4rem; margin-bottom: 15px;">💬</div>
          <h3 style="margin: 0 0 10px 0; color: var(--text-secondary);">Nenhuma conversa selecionada</h3>
          <p>Selecione um contato à esquerda para visualizar as mensagens</p>
        </div>`;
        await carregarConversas();
      } catch (error) {
        console.error('Erro ao deletar conversa:', error);
        alert('❌ Erro ao deletar conversa');
      }
    };

    // Buscar conversas
    $('searchConversations')?.addEventListener('input', (e) => {
      const searchTerm = e.target.value.toLowerCase().trim();

      if (!searchTerm) {
        // Sem busca: mostrar apenas as 5 mais recentes
        renderizarListaContatos(currentConversations, true);
        return;
      }

      const filtered = currentConversations.filter(conversa =>
        conversa.phone.includes(searchTerm) ||
        conversa.lastMessage.content.toLowerCase().includes(searchTerm)
      );

      // Com busca: mostrar todos os resultados filtrados
      renderizarListaContatos(filtered, false);
    });

    // Botão de atualizar conversas
    $('btnRefreshConversations')?.addEventListener('click', async () => {
      const btn = $('btnRefreshConversations');
      const originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = '⏳ Atualizando...';

      try {
        await carregarConversas();
      } catch (error) {
        console.error('Erro ao atualizar conversas:', error);
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });

    // Carregar Números Pass quando a aba for aberta
    const numerosPassTab = document.querySelector('[data-tab="numerospass"]');
    if (numerosPassTab) {
      numerosPassTab.addEventListener('click', () => {
        loadNumerosPass();
      });
    }

    // Carregar conversas quando a aba for aberta
    const conversasTab = document.querySelector('[data-tab="conversas"]');
    if (conversasTab) {
      conversasTab.addEventListener('click', () => {
        console.log('[Ver Conversas] Aba clicada, carregando conversas...');
        // Carregar apenas na primeira vez ou se a lista estiver vazia
        if (currentConversations.length === 0) {
          carregarConversas();
        } else {
          console.log('[Ver Conversas] Já existem conversas carregadas:', currentConversations.length);
        }
      });
      console.log('[Ver Conversas] Event listener registrado com sucesso');
    } else {
      console.error('[Ver Conversas] Botão da aba "conversas" não encontrado no DOM');
    }
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      lucide.createIcons();
    });
  </script>

  <!-- ── MODAL TUTORIAL ───────────────────────────────────────────── -->
  <div id="tutorialOverlay" style="display: none; position: fixed; inset: 0px; z-index: 9999; background: rgba(0, 0, 0, 0.92); backdrop-filter: blur(6px); align-items: center; justify-content: center; flex-direction: column;">
    <!-- Botão fechar -->
    <button onclick="closeTutorialModal()" style="position: absolute; top: 20px; right: 24px; background: transparent; border: 1px solid rgba(255, 255, 255, 0.25); color: rgb(240, 244, 255); border-radius: 4px; padding: 8px 18px; font-family: &quot;Space Grotesk&quot;, sans-serif; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: 0.2s;" onmouseenter="this.style.background=&#39;rgba(255,255,255,0.1)&#39;" onmouseleave="this.style.background=&#39;transparent&#39;">
      ✕ Fechar
    </button>

    <!-- Wrapper do vídeo -->
    <div style="width:90vw; max-width:900px;">
      <video id="tutorialVideo" src="https://neuralfoco.com.br/images/AtenteIA.mp4" autoplay="" muted="" playsinline="" webkit-playsinline="" loop="" controls="" style="width:100%; border-radius:8px; display:block; box-shadow:0 0 60px rgba(0,229,255,0.2);"></video>
    </div>

    <p style="margin-top:18px; color:rgba(255,255,255,0.4); font-size:0.78rem; font-family:&#39;Space Grotesk&#39;,sans-serif; letter-spacing:0.06em;">
      Este vídeo só aparece uma vez · clique em Fechar quando terminar
    </p>
  </div>

  <script>
    const TUTORIAL_KEY = 'atendeia_tutorial_seen';

    function openTutorialModal() {
      const overlay = document.getElementById('tutorialOverlay');
      overlay.style.display = 'flex';
      const vid = document.getElementById('tutorialVideo');
      vid.currentTime = 0;
      vid.muted = true;
      vid.play().catch(() => {});
    }

    function closeTutorialModal() {
      document.getElementById('tutorialOverlay').style.display = 'none';
      const vid = document.getElementById('tutorialVideo');
      vid.pause();
      localStorage.setItem(TUTORIAL_KEY, '1');
      const btn = document.getElementById('btnTutorial');
      if (btn) btn.style.display = '';
    }

    // Impede que qualquer coisa pause o vídeo enquanto o modal estiver aberto
    document.addEventListener('DOMContentLoaded', function() {
      const vid = document.getElementById('tutorialVideo');
      if (vid) {
        vid.addEventListener('pause', function() {
          const overlay = document.getElementById('tutorialOverlay');
          if (overlay && overlay.style.display !== 'none') {
            setTimeout(() => { this.play().catch(() => {}); }, 50);
          }
        });
      }

      const btn = document.getElementById('btnTutorial');
      if (!localStorage.getItem(TUTORIAL_KEY)) {
        setTimeout(openTutorialModal, 800);
      } else {
        if (btn) btn.style.display = '';
      }
    });
  </script>


</body></html>