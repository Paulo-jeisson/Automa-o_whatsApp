    const nav = document.querySelector('nav');
    window.addEventListener('scroll', () => {
      nav.style.boxShadow = window.scrollY > 20
        ? '0 4px 40px rgba(0,0,0,0.4)'
        : 'none';
    });

    // Explainer video — unmute toggle
    function toggleExplainerSound() {
      const video = document.getElementById('explainerVideo');
      const btn   = document.getElementById('explainerUnmute');
      const icon  = document.getElementById('explainerVolIcon');
      const label = document.getElementById('explainerVolLabel');

      if (video.muted) {
        video.muted = false;
        btn.classList.remove('is-muted');
        label.textContent = 'Silenciar';
        icon.innerHTML = '<polygon points="11,5 6,9 2,9 2,15 6,15 11,19"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>';
      } else {
        video.muted = true;
        btn.classList.add('is-muted');
        label.textContent = 'Ativar som';
        icon.innerHTML = '<polygon points="11,5 6,9 2,9 2,15 6,15 11,19"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>';
      }
    }
    // Estado inicial: mutado
    document.getElementById('explainerUnmute').classList.add('is-muted');

    // Thumbnail do vídeo explicativo — captura frame da plataforma via canvas
    (function() {
      const vid = document.getElementById('explainerVideo');
      if (!vid) return;
      var captured = false;

      function captureFrame() {
        if (captured) return;
        try {
          var canvas = document.createElement('canvas');
          canvas.width  = vid.videoWidth  || 1280;
          canvas.height = vid.videoHeight || 720;
          canvas.getContext('2d').drawImage(vid, 0, 0, canvas.width, canvas.height);
          var dataUrl = canvas.toDataURL('image/jpeg', 0.85);
          // só aplica se capturou algo real (não frame preto)
          if (dataUrl.length > 5000) {
            vid.setAttribute('poster', dataUrl);
            captured = true;
          }
        } catch(e) {}
      }

      // Busca frame ~8s onde a plataforma fica visível
      vid.addEventListener('loadedmetadata', function() {
        vid.addEventListener('seeked', function onSeeked() {
          vid.removeEventListener('seeked', onSeeked);
          captureFrame();
          // retorna ao início para o autoplay rodar do começo
          vid.currentTime = 0;
        });
        vid.currentTime = 8;
      }, { once: true });
    })();

    // SVGs inline para os estados dos botões
    const SVG_PAUSE = '<svg viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>';
    const SVG_PLAY  = '<svg viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21"/></svg>';
    const SVG_VOL   = '<svg viewBox="0 0 24 24"><polygon points="11,5 6,9 2,9 2,15 6,15 11,19"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>';
    const SVG_MUTE  = '<svg viewBox="0 0 24 24"><polygon points="11,5 6,9 2,9 2,15 6,15 11,19"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>';

    function playTestimonial(overlay) {
      const wrap = overlay.closest('.video-wrap');
      const video = wrap.querySelector('video');
      overlay.classList.add('hidden');
      wrap.querySelector('.video-controls').classList.add('visible');
      video.play();
    }

    function togglePause(btn) {
      const video = btn.closest('.video-wrap').querySelector('video');
      if (video.paused) { video.play(); btn.innerHTML = SVG_PAUSE; }
      else              { video.pause(); btn.innerHTML = SVG_PLAY; }
    }

    function toggleMute(btn) {
      const video = btn.closest('.video-wrap').querySelector('video');
      video.muted = !video.muted;
      btn.innerHTML = video.muted ? SVG_MUTE : SVG_VOL;
    }
  </script>

