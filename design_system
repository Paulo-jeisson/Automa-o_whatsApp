    .card:hover { border-color: var(--border-mid); transform: none; box-shadow: none; }
    .card:hover::before { width: 30px; height: 30px; box-shadow: -2px -2px 16px rgba(0,229,255,0.35); }
    .card:hover::after  { width: 30px; height: 30px; }

    .card h2 {
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--text-hi);
    }

    /* Banner topo */
    .top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: nowrap;
      background: var(--deep);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 10px 18px;
      margin-bottom: 14px;
      animation: entrance 0.4s ease-out both;
      position: relative;
      overflow: hidden;
    }

    .top-bar::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, var(--cyan), rgba(124,58,237,0.6), transparent);
      opacity: 0.45;
    }

    .top-bar-info { display: flex; flex-direction: column; gap: 2px; }
    .top-bar-info p { margin: 0; }

    .top-bar-actions {
      display: flex;
      align-items: center;
      gap: 7px;
      flex-wrap: nowrap;
      flex-shrink: 0;
    }

    .top-bar-divider {
      width: 1px;
      height: 28px;
      background: var(--border-mid);
      flex-shrink: 0;
    }

    .top-bar .btn-topbar {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px;
      border-radius: 2px;
      font-family: 'Syne Mono', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .btn-topbar-outline {
      background: transparent;
      border-color: var(--cyan) !important;
      color: var(--cyan) !important;
    }
    .btn-topbar-outline:hover { background: var(--cyan-dim); }

    .btn-topbar-green {
      background: transparent;
      border-color: var(--green) !important;
      color: var(--green) !important;
    }
    .btn-topbar-green:hover { background: var(--green-dim); }

    .btn-topbar-amber {
      background: transparent;
      border-color: var(--amber) !important;
      color: var(--amber) !important;
    }
    .btn-topbar-amber:hover { background: rgba(255,193,7,0.08); }

    .btn-topbar-violet {
      background: transparent;
      border-color: var(--violet) !important;
      color: #a78bfa !important;
    }
    .btn-topbar-violet:hover { background: rgba(124,58,237,0.12); }

    .btn-topbar-red {
      background: transparent;
      border-color: rgba(239,68,68,0.7) !important;
      color: #f87171 !important;
    }
    .btn-topbar-red:hover { background: rgba(239,68,68,0.1); }

    /* Theme Toggle Button */
    .btn-topbar-theme {
      background: transparent;
      border-color: rgba(136, 136, 200, 0.35) !important;
      color: var(--text-mid) !important;
      padding: 8px 10px !important;
      width: 36px;
      justify-content: center;
    }
    .btn-topbar-theme:hover {
      background: rgba(136, 136, 200, 0.08);
      border-color: rgba(136, 136, 200, 0.55) !important;
      color: var(--text-hi) !important;
    }
    .btn-topbar-theme [data-lucide] { width: 14px !important; height: 14px !important; }

    /* Light Theme Override */
    html.theme-light {
      --void:       #1a1a3e;
      --deep:       #22224e;
      --panel:      #292960;
      --surface:    #303070;
      --border:     rgba(140, 140, 240, 0.28);
      --border-mid: rgba(170, 170, 255, 0.42);
      --text-mid:   #b8c2ec;
      --text-lo:    #7878a8;
      --glass-bg:   rgba(255,255,255,0.05);
    }

    /* legacy — hide old separate sections */
    .card-creditos { display: none; }
    .user-menu { display: none; }

    /* === HEADER === */
    header {
      text-align: center;
      padding: 50px 20px 38px;
      margin-bottom: 20px;
      position: relative;
      overflow: hidden;
      animation: entrance 0.5s ease-out both;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: var(--deep);
    }

    header::before { display: none; }
    header::after  { display: none; }

    .header-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,229,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,229,255,0.025) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
    }

    .header-grid::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(0,229,255,0.85), transparent);
      animation: scan-line 7s linear infinite;
      animation-delay: 1.5s;
    }

    .header-orb { position: absolute; border-radius: 50%; filter: blur(65px); pointer-events: none; }

    .header-orb-1 {
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(124,58,237,0.22) 0%, transparent 65%);
      top: -140px; left: 50%;
      transform: translateX(-50%);
    }

    .header-orb-2 {
      width: 200px; height: 200px;
      background: radial-gradient(circle, rgba(0,229,255,0.14) 0%, transparent 65%);
      bottom: -50px; right: 12%;
    }

    .header-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: 'Syne Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--green);
      background: var(--green-dim);
      border: 1px solid rgba(0,255,136,0.2);
      border-radius: 2px;
      padding: 5px 14px;
      margin-bottom: 24px;
      position: relative;
      z-index: 1;
      animation: flicker 6s ease-in-out infinite;
      transition: color 0.4s ease, background 0.4s ease, border-color 0.4s ease;
    }

    .header-badge::before {
      content: '';
      display: inline-block;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
      animation: pulse-dot 2s ease-in-out infinite;
      transition: background 0.4s ease, box-shadow 0.4s ease;
    }

    .header-badge.inativo {
      color: var(--magenta);
      background: rgba(255,0,128,0.07);
      border-color: rgba(255,0,128,0.25);
    }
    .header-badge.inativo::before {
      background: var(--magenta);
      box-shadow: 0 0 8px var(--magenta);
      animation: none;
    }

    .header-title {
      font-family: 'Space Grotesk', sans-serif;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 14px;
      position: relative;
      z-index: 1;
      background: none;
      animation: none;
      text-shadow: none;
      -webkit-text-fill-color: unset;
      letter-spacing: -0.02em;
    }

    .header-title-line1 {
      font-size: 4.8rem; font-weight: 900; letter-spacing: -0.04em; line-height: 1;
      color: var(--text-hi); -webkit-text-fill-color: var(--text-hi); background: none;
    }

    .header-title-accent {
      font-size: 5.2rem; font-weight: 900; letter-spacing: -0.04em; line-height: 1;
      color: var(--cyan); -webkit-text-fill-color: var(--cyan); background: none; filter: none;
      text-shadow: 0 0 40px rgba(0,229,255,0.6), 0 0 80px rgba(0,229,255,0.25);
    }

    .header-title-version {
      font-family: 'Syne Mono', monospace;
      font-size: 1.1rem; font-weight: 400; letter-spacing: 0.12em;
      color: var(--text-mid); -webkit-text-fill-color: var(--text-mid); background: none; filter: none;
      margin-bottom: 9px;
      border: 1px solid var(--border-mid);
      padding: 3px 9px; border-radius: 2px;
    }

    .header-subtitle {
      font-family: 'Syne Mono', monospace;
      font-size: 0.65rem; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--text-lo); margin-bottom: 20px; position: relative; z-index: 1;
    }

    .header-line {
      width: 100px; height: 1px;
      background: linear-gradient(90deg, transparent, var(--cyan), transparent);
      margin: 0 auto 14px; position: relative; z-index: 1;
    }

    .header-dots {
      display: flex; justify-content: center; gap: 10px;
      position: relative; z-index: 1; border: none; padding: 0;
    }

    .header-dots span { width: 4px; height: 4px; border-radius: 50%; }
    .header-dots span:nth-child(1) { background: var(--cyan); box-shadow: 0 0 8px var(--cyan); animation: pulse-dot 2s ease-in-out infinite; }
    .header-dots span:nth-child(2) { background: var(--violet); box-shadow: 0 0 8px var(--violet); animation: pulse-dot 2s 0.4s ease-in-out infinite; }
    .header-dots span:nth-child(3) { background: var(--magenta); box-shadow: 0 0 8px var(--magenta); animation: pulse-dot 2s 0.8s ease-in-out infinite; }

    /* === TABS === */
    .tabs-wrapper {
      display: flex; gap: 0; align-items: flex-end;
      animation: entrance 0.65s ease-out both;
      position: relative; z-index: 1;
    }

    /* Seção de abas com header acima */
    .tabs-section {
      display: flex; flex-direction: column; gap: 0;
    }
    .tabs-section-header {
      font-family: 'Syne Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 4px 4px 0 0;
      margin-bottom: 2px;
      display: flex; align-items: center; gap: 6px;
      font-weight: 700;
    }
    .tabs-section-header.ia-header {
      background: rgba(0,229,255,0.08);
      border: 1px solid rgba(0,229,255,0.25);
      border-bottom: none;
      color: var(--cyan);
    }
    .tabs-section-header.tool-header {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-bottom: none;
      color: var(--text-lo);
    }
    .tabs-section-row {
      display: flex; gap: 2px; align-items: flex-end;
    }
    .tabs-section-divider {
      width: 1px; background: var(--border-mid);
      margin: 0 8px; align-self: stretch;
      min-height: 48px;
    }

    /* Badge de passo dentro da aba */
    .tab-step {
      display: block;
      font-size: 0.55rem;
      letter-spacing: 0.16em;
      color: var(--cyan);
      opacity: 0.85;
      margin-top: 3px;
      line-height: 1;
      font-weight: 700;
    }

    /* compatibilidade — tab-buttons usado pelo switchTab */
    .tab-buttons { display: none; }

    .tab-btn {
      padding: 9px 16px 11px;
      background: var(--deep);
      border: 1px solid var(--border);
      border-bottom: none;
      border-radius: 2px 2px 0 0;
      color: #c8d0f0;
      cursor: pointer;
      font-family: 'Syne Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      transition: all 0.2s ease;
      position: relative;
      margin-right: 2px;
      bottom: -1px;
      display: flex; flex-direction: column; align-items: center;
    }

    .tab-btn::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 2px;
      background: transparent;
      transition: background 0.2s ease, box-shadow 0.2s ease;
      border-radius: 2px 2px 0 0;
    }

    .tab-btn::after { display: none; }

    .tab-btn.active {
      background: var(--panel);
      color: var(--cyan);
      border-color: var(--border-mid);
      border-bottom-color: var(--panel);
      z-index: 2;
    }

    .tab-btn.active::before {
      background: var(--cyan);
      box-shadow: 0 0 10px var(--cyan-glow);
    }

    .tab-btn:hover:not(.active) {
      background: var(--surface);
      color: var(--text-hi);
      border-color: var(--border-mid);
    }

    .tab-area {
      border: 1px solid var(--border-mid);
      border-radius: 0 3px 3px 3px;
      padding: 26px;
      background: var(--panel);
      margin-bottom: 22px;
      position: relative;
    }

    .tab-content { display: none; animation: entrance 0.25s ease-out both; }
    .tab-content.ativo { display: block; }

    /* === FORM === */
    .form-group { margin-bottom: 18px; }

    .form-group label {
      display: block; margin-bottom: 6px;
      font-family: 'Syne Mono', monospace;
      font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: #dde6ff;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%; padding: 11px 15px;
      border: 1px solid var(--border); border-radius: 2px;
      background: var(--deep); color: var(--text-hi);
      font-family: 'Space Grotesk', sans-serif; font-size: 0.9rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease; outline: none;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
      border-color: rgba(0,229,255,0.4);
      box-shadow: 0 0 0 3px rgba(0,229,255,0.06);
      background: var(--surface);
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder { color: var(--text-lo); }

    .form-group textarea { min-height: 100px; resize: vertical; }

    .form-group select {
      cursor: pointer; appearance: none;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%2300e5ff' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 14px center;
      padding-right: 36px;
    }

    /* === BUTTONS === */
    .btn {
      padding: 11px 24px; border: 1px solid transparent; border-radius: 2px;
      font-family: 'Space Grotesk', sans-serif; font-size: 0.82rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer;
      transition: all 0.2s ease; position: relative; overflow: hidden;
    }

    .btn::before { display: none; }
    .btn:active  { transform: scale(0.98); box-shadow: none; }
    .btn:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }

    .btn-primary { background: transparent; color: var(--cyan); border-color: var(--cyan); }
    .btn-primary:hover:not(:disabled) { background: var(--cyan); color: var(--void); box-shadow: 0 0 24px rgba(0,229,255,0.4); transform: none; }

    .btn-success { background: transparent; color: var(--green); border-color: var(--green); }
    .btn-success:hover:not(:disabled) { background: var(--green); color: var(--void); box-shadow: 0 0 24px rgba(0,255,136,0.4); transform: none; }

    .btn-danger { background: transparent; color: var(--magenta); border-color: var(--magenta); }
    .btn-danger:hover:not(:disabled) { background: var(--magenta); color: white; box-shadow: 0 0 20px rgba(255,0,128,0.4); transform: none; }

    .btn-small { padding: 7px 14px; font-size: 0.72rem; }

    /* === USER MENU === */
    .user-menu {
      background: var(--deep); border: 1px solid var(--border); border-radius: 3px;
      padding: 12px 20px; margin-bottom: 14px;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px; position: relative; overflow: hidden;
      animation: entrance 0.35s ease-out both;
    }

    .user-menu::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(0,229,255,0.4), transparent);
      width: auto; box-shadow: none; border: none;
    }

    .user-menu::after { display: none; }

    .user-info { display: flex; align-items: center; gap: 14px; flex: 1; }

    .user-avatar {
      width: 38px; height: 38px; border-radius: 3px;
      background: var(--surface); border: 1px solid var(--border-hi);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem; flex-shrink: 0;
    }

    .user-details { display: flex; flex-direction: column; gap: 2px; }
    .user-email { font-size: 0.88rem; font-weight: 600; color: var(--text-hi); }

    .user-validity {
      font-family: 'Syne Mono', monospace; font-size: 0.65rem; color: var(--text-lo);
      display: flex; align-items: center; gap: 8px;
    }

    .validity-badge {
      display: inline-block; padding: 1px 6px; border-radius: 1px;
      font-family: 'Syne Mono', monospace; font-size: 0.6rem;
      letter-spacing: 0.1em; text-transform: uppercase;
    }

    .validity-badge.ativo     { background: var(--green-dim); color: var(--green); border: 1px solid rgba(0,255,136,0.2); }
    .validity-badge.expirando { background: rgba(255,193,7,0.1); color: var(--amber); border: 1px solid rgba(255,193,7,0.2); }
    .validity-badge.expirado  { background: rgba(255,0,128,0.1); color: var(--magenta); border: 1px solid rgba(255,0,128,0.2); }
    .validity-badge.sem_validade { background: rgba(60,60,100,0.2); color: var(--text-lo); border: 1px solid var(--border); }

    .user-actions { display: flex; gap: 8px; }

    /* === BANNER DE PAGAMENTO === */
    #payment-banner {
      display: none;
      position: fixed; top: 0; left: 0; right: 0; z-index: 9999;
      padding: 12px 24px;
      display: flex; align-items: center; justify-content: center; gap: 16px;
      font-family: 'Syne Mono', monospace; font-size: 0.78rem; letter-spacing: 0.06em;
    }
    #payment-banner.banner-warning {
      background: linear-gradient(90deg, rgba(255,193,7,0.15), rgba(255,193,7,0.08));
      border-bottom: 1px solid rgba(255,193,7,0.35);
      color: var(--amber);
    }
    #payment-banner.banner-danger {
      background: linear-gradient(90deg, rgba(255,0,128,0.18), rgba(255,0,128,0.08));
      border-bottom: 1px solid rgba(255,0,128,0.4);
      color: var(--magenta);
    }
    .banner-btn {
      padding: 6px 16px; border-radius: 6px; border: none; cursor: pointer;
      font-family: 'Syne Mono', monospace; font-size: 0.72rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.08em; text-decoration: none;
      transition: opacity 0.2s;
    }
    .banner-btn:hover { opacity: 0.85; }
    .banner-btn-mensal { background: var(--amber); color: #0a0a1e; }
    .banner-btn-anual  { background: var(--green); color: #0a0a1e; }

    /* === DICA === */
    .dica {
      background: rgba(0,229,255,0.04); border-left: 2px solid var(--cyan);
      padding: 13px 17px; border-radius: 0 2px 2px 0; margin: 14px 0;
      font-size: 0.87rem; color: var(--text-mid); line-height: 1.65;
    }

    .dica strong { color: var(--text-hi); }

    /* === QR CODE === */
    #qr-area {
      text-align: center; padding: 42px 22px; min-height: 250px;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      background: var(--deep); border: 1px dashed var(--border); border-radius: 2px;
      transition: all 0.3s ease;
    }

    #qr-area:has(img) { border-color: rgba(0,255,136,0.3); border-style: solid; background: rgba(0,255,136,0.015); }

    #qr-area img {
      max-width: 270px; border-radius: 3px; border: 1px solid var(--border-mid);
      animation: entrance 0.5s ease-out both;
    }

    #qr-area .msg {
      margin-top: 14px; font-family: 'Syne Mono', monospace;
      font-size: 0.75rem; letter-spacing: 0.05em; color: var(--text-mid);
      max-width: 380px; line-height: 1.6;
    }

    #qr-area .status-ok       { color: var(--green); }
    #qr-area .status-pendente { color: var(--text-lo); }

    .qr-loading { animation: none; }

    #qr-buttons { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 16px; }

    #status-conectado {
      background: rgba(0,255,136,0.04) !important;
      border: 1px solid rgba(0,255,136,0.18) !important;
      border-radius: 2px !important; margin-bottom: 18px;
    }

    /* === MODAL === */
    .modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.88); backdrop-filter: blur(10px);
      z-index: 1000; align-items: center; justify-content: center;
    }

    .modal-overlay.active { display: flex; }

    .modal-box {
      background: var(--panel); border: 1px solid var(--border-mid); border-radius: 3px;
      padding: 28px; max-width: 420px; width: 90%;
      box-shadow: 0 0 60px rgba(0,0,0,0.9); animation: entrance 0.25s ease-out both;
      position: relative;
    }

    .modal-box::before {
      content: ''; position: absolute; top: -1px; left: -1px;
      width: 22px; height: 22px;
      border-top: 1px solid var(--cyan); border-left: 1px solid var(--cyan);
      border-radius: 2px 0 0 0; box-shadow: none;
    }

    .modal-box::after { display: none; }

    .modal-box h2 {
      font-family: 'Space Grotesk', sans-serif; font-size: 0.82rem; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--cyan); margin-bottom: 20px;
    }

    .form-group-modal { margin-bottom: 15px; }

    .form-group-modal label {
      display: block; font-family: 'Syne Mono', monospace;
      font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: #dde6ff; margin-bottom: 6px;
    }

    .form-group-modal input {
      width: 100%; padding: 10px 14px; background: var(--deep);
      border: 1px solid var(--border); border-radius: 2px;
      color: var(--text-hi); font-family: 'Space Grotesk', sans-serif;
      font-size: 0.87rem; transition: border-color 0.2s ease; outline: none;
    }

    .form-group-modal input:focus { border-color: rgba(0,229,255,0.4); box-shadow: 0 0 0 2px rgba(0,229,255,0.07); }

    .modal-actions-box { display: flex; gap: 10px; margin-top: 20px; }
    .modal-actions-box button { flex: 1; }

