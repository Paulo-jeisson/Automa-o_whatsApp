      background-size: 60px 60px;
      pointer-events: none;
    }
    .hero-grid::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(0,229,255,0.9), transparent);
      animation: scan-line 9s linear infinite;
      animation-delay: 2s;
    }
    .hero-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      padding: 80px 0;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
