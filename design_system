    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --void:       #0c0c1e;
      --deep:       #10102a;
      --panel:      #161630;
      --surface:    #1c1c3a;
      --border:     rgba(90, 90, 180, 0.15);
