# Valores que contenham $ devem ser envolvidos por aspas simples no .env.
# Exemplo: CHAVE='valor$literal'. Não duplique $ porque o Django também lê este arquivo.
# Django
APP_ENV=development
DJANGO_SECRET_KEY=<gere-uma-chave-longa-e-aleatoria>
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000

# Meta / WhatsApp Cloud API
META_VERIFY_TOKEN=<crie-um-token-de-verificacao-longo>
META_APP_SECRET=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=
WHATSAPP_TOKEN_ENCRYPTION_KEY=<gere-uma-chave-fernet-exclusiva>

# Integração atual do MVP
WHATSAPP_PROVIDER=wa.me
IAATENDE_WHATSAPP=

# Banco e logs
SQLITE_NAME=db.sqlite3
WHATSAPP_LOG_LEVEL=INFO
WHATSAPP_WEBHOOK_MAX_BYTES=1048576

# PostgreSQL (obrigatório com app.settings_production)
POSTGRES_DB=iaatende
POSTGRES_USER=iaatende
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5

# Segurança de produção
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_AGE=3600

# E-mail para recuperação de senha
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=xxxxxxxx@gmail.com
# Use exclusivamente uma Senha de App do Google; nunca a senha normal da conta.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=IAATENDE 2.0 <xxxxxxxx@gmail.com>
PASSWORD_RESET_TIMEOUT=3600

# OpenAI (somente no backend)
OPENAI_API_KEY=
AI_ENABLED=False
AI_MODEL=gpt-5.6
AI_TIMEOUT=20
AI_CONTEXT_MESSAGE_LIMIT=12
AI_CONTEXT_SUMMARY_TRIGGER=20
AI_CONTEXT_SUMMARY_MAX_CHARS=2000
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
# Billing Asaas (comece sempre pelo Sandbox)
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=''
ASAAS_WEBHOOK_TOKEN=
ASAAS_CHECKOUT_SUCCESS_URL=http://127.0.0.1:8000/assinatura/retorno/
ASAAS_CHECKOUT_CANCEL_URL=http://127.0.0.1:8000/planos/
ASAAS_CHECKOUT_EXPIRES_IN=60
SUBSCRIPTION_ENFORCEMENT_ENABLED=true
TASK_QUEUE_EAGER=True
TASK_QUEUE_BACKOFF=30
TASK_QUEUE_MAX_BACKOFF=3600
TASK_QUEUE_LEASE_SECONDS=300
TASK_QUEUE_IDLE_SECONDS=1
TASK_QUEUE_HEARTBEAT_SECONDS=30
OPERATIONAL_ALERT_WEBHOOK=
# WhatsApp Web / Evolution API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_URL=
JWT_ACCESS_SECONDS=900
JWT_REFRESH_SECONDS=604800
