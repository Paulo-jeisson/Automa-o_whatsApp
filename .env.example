# Django
DJANGO_SECRET_KEY=<gere-uma-chave-longa-e-aleatoria>
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Meta / WhatsApp Cloud API
META_VERIFY_TOKEN=<crie-um-token-de-verificacao-longo>
META_APP_SECRET=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=
WHATSAPP_TOKEN_ENCRYPTION_KEY=<gere-uma-chave-fernet-exclusiva>

# Integração atual do MVP
WHATSAPP_PROVIDER=wa.me
ZAPFLUXO_WHATSAPP=

# Banco e logs
SQLITE_NAME=db.sqlite3
WHATSAPP_LOG_LEVEL=INFO
WHATSAPP_WEBHOOK_MAX_BYTES=1048576

# PostgreSQL (obrigatório com app.settings_production)
POSTGRES_DB=zapfluxo
POSTGRES_USER=zapfluxo
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5

# Segurança de produção
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_AGE=3600

# E-mail para recuperação de senha
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ZapFluxo <nao-responda@seudominio.com.br>

# OpenAI (somente no backend)
OPENAI_API_KEY=
AI_ENABLED=False
AI_MODEL=gpt-5.6
AI_TIMEOUT=20
AI_CONTEXT_MESSAGE_LIMIT=12
AI_CONTEXT_SUMMARY_TRIGGER=20
AI_CONTEXT_SUMMARY_MAX_CHARS=2000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-06-30.basil
TRIAL_DAYS=14
